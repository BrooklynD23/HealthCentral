# Asclexis Environment Configuration
# Copy this file to .env and customize for your environment

# =============================================================================
# APPLICATION MODE
# =============================================================================
# Deployment mode: "local" (default), "server" (future web deployment)
APP_MODE=local

# Environment: "development", "production"
APP_ENV=development

# Debug mode (enables verbose logging, auto-reload)
DEBUG=true

# SQL statement logging (default false). Separate from DEBUG since S-1:
# DEBUG=true no longer prints SQL.
# Bound values (lab results, names, notes) are never printed, even when true.
SQL_ECHO=false

# =============================================================================
# SERVER CONFIGURATION (Local-only by default)
# =============================================================================
# Host binding - MUST be 127.0.0.1 for local-only operation
# WARNING: Do not change to 0.0.0.0 unless you understand the security implications
HOST=127.0.0.1

# Port for backend API
PORT=8000

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Database type: "sqlite" (local), "postgresql" (future server mode)
DATABASE_TYPE=sqlite

# SQLite database path (relative to app data directory)
# Each profile has its own encrypted vault.db
# Both the directory and the filename are honoured.
SQLITE_DATABASE_PATH=data/asclexis.db

# SQLCipher encryption (enabled by default for local mode)
DATABASE_ENCRYPTION_ENABLED=true

# Require SQLCipher for profile database encryption
# Set to false ONLY for development without SQLCipher installed
# See README.md "SQLCipher Setup" for installation instructions
DATABASE_ENCRYPTION_REQUIRED=true

# PostgreSQL connection (for future server mode)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=asclexis
# POSTGRES_PASSWORD=your_secure_password
# POSTGRES_DATABASE=asclexis

# =============================================================================
# SECURITY
# =============================================================================
# Auto-lock timeout in minutes (0 = disabled)
AUTO_LOCK_TIMEOUT_MINUTES=15

# Use Windows DPAPI for key protection (Windows only)
USE_DPAPI=true

# JWT secret for API authentication (auto-generated if not set)
# JWT_SECRET=your_secure_random_secret

# JWT token revocation (invalidate tokens on logout by `jti`)
JWT_REVOCATION_ENABLED=true

# Auth endpoint rate limiting (brute-force protection)
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# =============================================================================
# LOCAL AI MODELS
# =============================================================================
# Path to local models directory
MODELS_PATH=models/

# Default chat model (GGUF format)
# Options: phi-3-mini, gemma-2-2b, qwen2.5-3b, llama-3.1-8b
DEFAULT_CHAT_MODEL=phi-3-mini

# Default embeddings model
# Options: bge-small-en-v1.5, e5-small-v2
DEFAULT_EMBEDDINGS_MODEL=bge-small-en-v1.5

# Context window size for chat model
CHAT_CONTEXT_SIZE=4096

# Number of CPU threads for inference (0 = auto)
INFERENCE_THREADS=0

# =============================================================================
# VECTOR STORE
# =============================================================================
# Vector store type: "sqlite-vss" (default), "faiss"
VECTOR_STORE_TYPE=sqlite-vss

# Embedding dimensions (must match embeddings model)
EMBEDDING_DIMENSIONS=384

# =============================================================================
# DOCUMENT PROCESSING
# =============================================================================
# Maximum file size for import (MB)
MAX_IMPORT_FILE_SIZE_MB=50

# Supported document types
SUPPORTED_DOC_TYPES=pdf,png,jpg,jpeg,csv,json

# OCR enabled (Phase 1+). On Windows, dev.ps1 installs Tesseract/Poppler when
# possible and sets this from PATH detection. Set HC_SKIP_OCR_SETUP=1 to skip.
OCR_ENABLED=false

# Future: structured lab extraction via local LLM (not wired yet; reserved flag)
AI_ASSISTED_LAB_EXTRACTION=false

# Allow reading legacy plaintext documents created by older app versions.
# WARNING: Enabling this weakens "encrypted at rest" guarantees for existing files.
ALLOW_LEGACY_PLAINTEXT_DOCUMENTS=false

# =============================================================================
# LOGGING
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log file path (relative to app data directory)
LOG_FILE_PATH=logs/asclexis.log

# Audit log enabled
AUDIT_LOG_ENABLED=true

# =============================================================================
# LLM PROVIDER SELECTION (P1: model-agnostic provider layer)
# =============================================================================
# Which inference backend to use.
# Options:
#   llama_cpp  — local GGUF file via llama-cpp-python (default, always local)
#   ollama     — local Ollama daemon at localhost:11434 (must be running)
LLM_PROVIDER=llama_cpp

# Model identifier for the selected provider.
#   llama_cpp:  absolute path to a .gguf file, or empty to auto-detect
#               (auto-detect scans MODELS_PATH for *.gguf, prefers q4/q5)
#   ollama:     Ollama model tag — examples:
#                 gemma4:e2b    ~2 GB, edge/phone class hardware
#                 gemma4:e4b    ~4 GB, mid-range laptops
#                 gemma4:12b    ~8 GB Q4, recommended for 16 GB RAM
#                 gemma4:26b    ~16 GB Q4, high-end desktop (MoE, 4B active)
#                 gemma4:31b    ~20 GB Q4, workstation/server
#                 phi-3-mini    legacy mid-tier (llama_cpp fallback)
LLM_MODEL=

# Ollama daemon base URL — MUST be localhost (non-local URLs refused at startup)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# =============================================================================
# FUTURE: ONLINE FEATURES (Phase 4+, opt-in only)
# =============================================================================
# Online model usage (requires explicit consent)
# ONLINE_MODELS_ENABLED=false
# ONLINE_API_ENDPOINT=
# ONLINE_API_KEY=

# Redaction pipeline for online requests
# REDACTION_ENABLED=true
