{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_log.py\" || python \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_log.py\"", "async": true }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_log.py\" || python \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_log.py\"", "async": true }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_log.py\" || python \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_log.py\"" }
        ]
      }
    ]
  }
}
