@@ -0,0 +1,60 @@
+import * as Popover from '@radix-ui/react-popover';
+import { FileText, X } from 'lucide-react';
+
+/**
+ * Provenance Peek: a citation opens on tap, click, Enter or Space — never
+ * hover-only — and scales out of its own chip. Escape and outside-click close
+ * it, and focus returns to the chip (Radix).
+ */
+export function ProvenancePeek({
+  n,
+  docTitle,
+  page,
+  quote,
+  collected,
+}: {
+  n: number;
+  docTitle: string;
+  page: number;
+  quote: string;
+  collected: string;
+}) {
+  return (
+    <Popover.Root>
+      <Popover.Trigger
+        className="pressable inline-flex min-h-11 items-center gap-2 rounded-full border border-line bg-raised px-3 text-cap font-medium text-fg-2 hover:border-line-strong hover:text-fg data-[state=open]:border-brand data-[state=open]:text-brand-ink"
+        aria-label={`Source ${n}: ${docTitle}, page ${page}`}
+      >
+        <span className="tnum grid size-5 place-items-center rounded-full bg-brand-wash text-[12px] font-semibold text-brand-ink">{n}</span>
+        <span className="max-w-[16rem] truncate">{docTitle}</span>
+        <span className="text-fg-3">p.{page}</span>
+      </Popover.Trigger>
+      <Popover.Portal>
+        <Popover.Content
+          side="top"
+          align="start"
+          sideOffset={8}
+          collisionPadding={16}
+          className="peek z-50 w-[min(360px,calc(100vw-32px))] rounded-[14px] border border-line bg-raised p-4 shadow-overlay"
+        >
+          <div className="flex items-start gap-3">
+            <FileText className="mt-0.5 size-4 shrink-0 text-fg-3" aria-hidden="true" />
+            <div className="min-w-0 flex-1">
+              <p className="text-ui font-semibold text-fg">{docTitle}</p>
+              <p className="text-cap text-fg-2">Page {page} · collected {collected}</p>
+            </div>
+            <Popover.Close aria-label="Close source" className="pressable -m-2 grid size-11 place-items-center rounded-[10px] text-fg-3 hover:text-fg">
+              <X className="size-4" />
+            </Popover.Close>
+          </div>
+          <blockquote className="tnum mt-3 rounded-[10px] bg-well px-3 py-2.5 text-ui text-fg">“{quote}”</blockquote>
+          <p className="mt-3 text-cap text-fg-2">This is what your report states. Open the document to see it in context.</p>
+          <a href="/inbox" className="mt-2 inline-flex min-h-11 items-center text-ui font-semibold text-brand-ink underline underline-offset-4">
+            Open document
+          </a>
+          <Popover.Arrow className="fill-raised" />
+        </Popover.Content>
+      </Popover.Portal>
+    </Popover.Root>
+  );
+}
diff --git a/src/frontend/src/proto/RangeRibbon.tsx b/src/frontend/src/proto/RangeRibbon.tsx
new file mode 100644
index 0000000..866f3bf
--- /dev/null
+++ b/src/frontend/src/proto/RangeRibbon.tsx
@@ -0,0 +1,177 @@
+import { useEffect, useLayoutEffect, useMemo, useRef, useState } from 'react';
+
+export type RibbonPoint = { date: string; value: number; verified: boolean };
+
+const drawnThisSession = new Set<string>();
+
+const fmtDate = (iso: string) =>
+  new Date(`${iso.slice(0, 10)}T12:00:00`).toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
+const fmtLong = (iso: string) =>
+  new Date(`${iso.slice(0, 10)}T12:00:00`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
+
+export function rangeState(v: number, low: number | null, high: number | null) {
+  if (high !== null && v > high) return 'above' as const;
+  if (low !== null && v < low) return 'below' as const;
+  return 'within' as const;
+}
+
+/**
+ * The Range Ribbon. Position against the lab's printed range is the signal;
+ * colour never shouts, and every point animates identically whatever its value
+ * ("value-blind motion"). The line draws once per analyte per session.
+ */
+export function RangeRibbon({
+  id,
+  points,
+  low,
+  high,
+  unit,
+  label,
+}: {
+  id: string;
+  points: RibbonPoint[];
+  low: number | null;
+  high: number | null;
+  unit: string;
+  label: string;
+}) {
+  const wrapRef = useRef<HTMLDivElement>(null);
+  const [width, setWidth] = useState(640);
+  const [focus, setFocus] = useState<number | null>(null);
+  const [draw] = useState(() => !drawnThisSession.has(id));
+
+  useEffect(() => {
+    drawnThisSession.add(id);
+  }, [id]);
+
+  useLayoutEffect(() => {
+    const el = wrapRef.current;
+    if (!el) return;
+    setWidth(Math.max(280, Math.round(el.getBoundingClientRect().width))); // measure before first paint: no resize shift
+    const ro = new ResizeObserver(([entry]) => setWidth(Math.max(280, Math.round(entry.contentRect.width))));
+    ro.observe(el);
+    return () => ro.disconnect();
+  }, []);
+
+  const height = width < 520 ? 208 : 248;
+  const pad = { l: 12, r: 56, t: 20, b: 34 };
+
+  const geo = useMemo(() => {
+    const values = points.map((p) => p.value);
+    let lo = Math.min(...values, low ?? Infinity);
+    let hi = Math.max(...values, high ?? -Infinity);
+    const span = hi - lo || Math.abs(hi) || 1;
+    lo -= span * 0.14;
+    hi += span * 0.14;
+    if (low !== null && low >= 0 && lo < 0) lo = Math.min(0, Math.min(...values));
+    const t = points.map((p) => new Date(p.date).getTime());
+    const t0 = Math.min(...t);
+    const t1 = Math.max(...t);
+    const x = (ms: number) => pad.l + 8 + ((ms - t0) / (t1 - t0 || 1)) * (width - pad.l - pad.r - 16);
+    const y = (v: number) => pad.t + (1 - (v - lo) / (hi - lo)) * (height - pad.t - pad.b);
+    const xy = points.map((p, i) => ({ ...p, x: x(t[i]), y: y(p.value) }));
+    return { x, y, xy, lo, hi };
+  }, [points, low, high, width, height, pad.l, pad.r, pad.t, pad.b]);
+
+  const bandTop = high !== null ? geo.y(high) : pad.t;
+  const bandBottom = low !== null ? geo.y(Math.max(low, geo.lo)) : height - pad.b;
+  const path = geo.xy.map((p, i) => `${i ? 'L' : 'M'}${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' ');
+  const last = geo.xy.length - 1;
+  const sp = geo.xy[focus ?? last];
+  const state = rangeState(sp.value, low, high);
+  const stateText = state === 'above' ? 'above the report’s range' : state === 'below' ? 'below the report’s range' : 'within the report’s range';
+
+  const rangeText =
+    low !== null && high !== null ? `${low}–${high}` : high !== null ? `up to ${high}` : `${low} or more`;
+
+  return (
+    <figure className="m-0">
+      <div ref={wrapRef} className="relative">
+        <svg
+          width={width}
+          height={height}
+          viewBox={`0 0 ${width} ${height}`}
+          role="group"
+          aria-label={`${label} over time against the report range ${rangeText} ${unit}. Use Tab to move between results.`}
+          className="block overflow-visible"
+        >
+          {/* Range band */}
+          <rect x={pad.l} y={bandTop} width={width - pad.l - pad.r} height={Math.max(0, bandBottom - bandTop)} rx={6} className="fill-band" />
+          <line x1={pad.l} x2={width - pad.r} y1={bandTop} y2={bandTop} className="stroke-brand" strokeOpacity={0.45} strokeDasharray="3 4" />
+          {low !== null && low > geo.lo && (
+            <line x1={pad.l} x2={width - pad.r} y1={bandBottom} y2={bandBottom} className="stroke-brand" strokeOpacity={0.45} strokeDasharray="3 4" />
+          )}
+          {high !== null && (
+            <text x={width - pad.r + 8} y={bandTop + 4} className="fill-fg-2 tnum" fontSize={13}>{high}</text>
+          )}
+          {low !== null && low > geo.lo && (
+            <text x={width - pad.r + 8} y={bandBottom + 4} className="fill-fg-2 tnum" fontSize={13}>{low}</text>
+          )}
+
+          {/* Line: honest straight segments between real results */}
+          <g className="ribbon-line" data-draw={draw}>
+            <path d={path} fill="none" className="stroke-brand" strokeWidth={2.25} strokeLinejoin="round" strokeLinecap="round" />
+          </g>
+
+          {/* Halo on the latest result is static: no pulse, whatever the value */}
+          <circle cx={geo.xy[last].x} cy={geo.xy[last].y} r={13} className="fill-brand" fillOpacity={0.14} />
+
+          {geo.xy.map((p, i) => {
+            const s = rangeState(p.value, low, high);
+            const a11y = `${fmtLong(p.date)}: ${p.value} ${unit}, ${
+              s === 'above' ? 'above' : s === 'below' ? 'below' : 'within'
+            } the report’s range${p.verified ? '' : ', not yet checked by you'}`;
+            return (
+              <g key={p.date} tabIndex={0} role="img" aria-label={a11y} onFocus={() => setFocus(i)} onBlur={() => setFocus(null)}
+                onPointerEnter={() => setFocus(i)} onPointerLeave={() => setFocus(null)} className="cursor-default outline-none">
+                <circle cx={p.x} cy={p.y} r={22} fill="transparent" />
+                {focus === i && <circle cx={p.x} cy={p.y} r={11} fill="none" className="stroke-brand" strokeWidth={2} />}
+                <circle
+                  cx={p.x}
+                  cy={p.y}
+                  r={i === last ? 6.5 : 5}
+                  className="ribbon-point fill-raised stroke-brand"
+                  data-draw={draw}
+                  style={draw ? { animationDelay: `${Math.min(i, 5) * 40 + 360}ms` } : undefined}
+                  strokeWidth={2.25}
+                  strokeDasharray={p.verified ? undefined : '2.5 2.5'}
+                  fill={p.verified ? undefined : 'transparent'}
+                />
+                {p.verified && <circle cx={p.x} cy={p.y} r={i === last ? 3 : 2.25} className="ribbon-point fill-brand" data-draw={draw}
+                  style={draw ? { animationDelay: `${Math.min(i, 5) * 40 + 360}ms` } : undefined} />}
+              </g>
+            );
+          })}
+
+          {geo.xy.map((p) => (
+            <text key={`x-${p.date}`} x={p.x} y={height - 10} textAnchor="middle" className="fill-fg-2" fontSize={13}>
+              {fmtDate(p.date)}
+            </text>
+          ))}
+        </svg>
+
+        {/* Callout: data reads instantly, it never animates in. Hidden until a point is hovered or focused. */}
+        {focus !== null && <div
+          className="pointer-events-none absolute z-10 -translate-x-1/2 -translate-y-full rounded-[10px] border border-line bg-raised px-3 py-2 shadow-overlay"
+          style={{ left: Math.min(Math.max(sp.x, 90), width - 90), top: sp.y - 18 }}
+          aria-hidden="true"
+        >
+          <p className="tnum whitespace-nowrap text-ui font-semibold text-fg">
+            {sp.value} <span className="font-normal text-fg-2">{unit}</span>
+          </p>
+          <p className="whitespace-nowrap text-cap text-fg-2">
+            {fmtLong(sp.date)}
+            {sp.verified ? '' : ' · not yet checked'}
+          </p>
+        </div>}
+      </div>
+      <div className="mt-2 flex flex-wrap items-center gap-x-5 gap-y-1 px-1 text-cap text-fg-2" aria-hidden="true">
+        <span className="inline-flex items-center gap-2"><span className="h-3 w-5 rounded-[3px] bg-band ring-1 ring-brand/40" />Report range {rangeText} {unit}</span>
+        {points.some((p) => !p.verified) && <span className="inline-flex items-center gap-2"><svg width="12" height="12" viewBox="0 0 12 12"><circle cx="6" cy="6" r="4.5" fill="none" className="stroke-brand" strokeWidth="2" strokeDasharray="2.5 2.5" /></svg>Not yet checked by you</span>}
+      </div>
+      <figcaption className="sr-only" aria-live="polite">
+        {fmtLong(sp.date)}: {sp.value} {unit}, {stateText}.
+      </figcaption>
+    </figure>
+  );
+}
