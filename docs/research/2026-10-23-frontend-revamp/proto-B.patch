+              </div>
+
+              {/* Contextual disclaimer: static, never inside an animated element. */}
+              <p className="mt-5 rounded-[12px] bg-well px-4 py-3 text-ui text-fg-2">
+                <strong className="font-semibold text-fg">Educational, not medical advice.</strong> This shows what your
+                report states. Whether this value matters for you is a question for your clinician.
+              </p>
+
+              <div className="mt-5 flex flex-wrap gap-2">
+                <Link to="/explain" className="pressable inline-flex min-h-11 items-center gap-2 rounded-[10px] bg-brand px-4 text-ui font-semibold text-on-brand">
+                  <MessageCircle className="size-4" aria-hidden="true" /> Ask about this result
