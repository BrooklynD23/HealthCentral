diff --git a/src/frontend/mock-api.ts b/src/frontend/mock-api.ts
new file mode 100644
index 0000000..85c31f1
--- /dev/null
+++ b/src/frontend/mock-api.ts
@@ -0,0 +1,94 @@
+/**
+ * Prototype-only mock of the observation endpoints the Results screen reads.
+ * Shapes follow src/services/types.ts (Observation, TrendData). No network.
+ */
+import type { Plugin } from 'vite';
+
+type Series = {
+  canonical: string;
+  raw: string;
+  unit: string;
+  low: number | null;
+  high: number | null;
+  doc: string;
+  page: number;
+  points: Array<[string, number, boolean]>; // date, value, verified
+};
+
+const SERIES: Series[] = [
+  { canonical: 'glucose', raw: 'Glucose, fasting', unit: 'mg/dL', low: 70, high: 99, doc: 'Metabolic panel — Valley Clinic Lab', page: 1,
+    points: [['2025-10-10', 92, true], ['2026-01-10', 104, true], ['2026-04-10', 118, true], ['2026-07-10', 101, false]] },
+  { canonical: 'hba1c', raw: 'Hemoglobin A1c', unit: '%', low: 4.0, high: 5.6, doc: 'HbA1c report — Valley Clinic Lab', page: 1,
+    points: [['2025-10-10', 5.3, true], ['2026-01-10', 5.4, true], ['2026-04-10', 5.9, true], ['2026-07-10', 6.1, true]] },
+  { canonical: 'ldl_cholesterol', raw: 'LDL Cholesterol', unit: 'mg/dL', low: 0, high: 99, doc: 'Lipid panel — Valley Clinic Lab', page: 2,
+    points: [['2025-10-10', 128, true], ['2026-04-10', 135, true], ['2026-07-10', 142, false]] },
+  { canonical: 'hdl_cholesterol', raw: 'HDL Cholesterol', unit: 'mg/dL', low: 40, high: null, doc: 'Lipid panel — Valley Clinic Lab', page: 2,
+    points: [['2025-10-10', 52, true], ['2026-04-10', 50, true], ['2026-07-10', 48, true]] },
+  { canonical: 'triglycerides', raw: 'Triglycerides', unit: 'mg/dL', low: 0, high: 149, doc: 'Lipid panel — Valley Clinic Lab', page: 2,
+    points: [['2025-10-10', 140, true], ['2026-04-10', 151, true], ['2026-07-10', 160, true]] },
+  { canonical: 'tsh', raw: 'TSH', unit: 'mIU/L', low: 0.4, high: 4.0, doc: 'Thyroid panel — Valley Clinic Lab', page: 1,
+    points: [['2026-01-10', 1.8, true], ['2026-07-10', 2.1, true]] },
+  { canonical: 'hemoglobin', raw: 'Hemoglobin', unit: 'g/dL', low: 12.0, high: 15.5, doc: 'CBC — Valley Clinic Lab', page: 1,
+    points: [['2026-01-10', 13.6, true], ['2026-07-10', 13.9, true]] },
+];
+
+const outside = (v: number, lo: number | null, hi: number | null) =>
+  (lo !== null && v < lo) || (hi !== null && v > hi);
+
+function observations() {
+  const out: unknown[] = [];
+  for (const s of SERIES) {
+    s.points.slice().reverse().forEach(([date, value, verified], i) => {
+      out.push({
+        id: `${s.canonical}-${i}`, profile_id: 'p1', doc_id: `doc-${s.canonical}-${date}`,
+        analyte_canonical: s.canonical, analyte_raw: s.raw, value, value_text: null, unit: s.unit,
+        ref_low: s.low, ref_high: s.high,
+        ref_range_text: s.high === null ? `>${s.low}` : `${s.low}-${s.high}`,
+        flag: outside(value, s.low, s.high) ? (s.high !== null && value > s.high ? 'H' : 'L') : null,
+        is_abnormal: outside(value, s.low, s.high), collected_at: `${date}T08:00:00`,
+        user_verified: verified, extraction_confidence: verified ? 0.96 : 0.62, source_page: s.page,
+        source_bbox_json: null, source_doc_title: s.doc,
+      });
+    });
+  }
+  return out;
+}
+
+function trend(canonical: string) {
+  const s = SERIES.find((x) => x.canonical === canonical);
+  if (!s) return null;
+  return {
+    analyte_canonical: s.canonical, analyte_display_name: s.raw, unit: s.unit, ref_low: s.low, ref_high: s.high,
+    summary: '',
+    data_points: s.points.map(([date, value, verified]) => ({
+      date, value, unit: s.unit, is_abnormal: outside(value, s.low, s.high), flag: null,
+      doc_id: `doc-${s.canonical}-${date}`, extraction_confidence: verified ? 0.96 : 0.62,
+      user_verified: verified, source_doc_title: s.doc, source_page: s.page,
+    })),
+  };
+}
+
+export function mockApi(): Plugin {
+  return {
+    name: 'proto-mock-api',
+    configureServer(server) {
+      server.middlewares.use((req, res, next) => {
+        if (!req.url || !req.url.startsWith('/api/v1/')) return next();
+        const url = new URL(req.url, 'http://x');
+        const send = (body: unknown, status = 200) => {
+          res.statusCode = status;
+          res.setHeader('Content-Type', 'application/json');
+          res.end(JSON.stringify(body));
+        };
+        const m = url.pathname.match(/^\/api\/v1\/observations\/trends\/([^/]+)/);
+        if (m) {
+          const t = trend(decodeURIComponent(m[1]));
+          return t ? send(t) : send({ detail: 'not found' }, 404);
+        }
+        if (url.pathname.replace(/\/$/, '') === '/api/v1/observations') return send(observations());
+        if (req.method === 'GET') return send([]);
+        return send({ ok: true });
+      });
+    },
+  };
+}
