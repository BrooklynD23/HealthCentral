+                  <Send className="size-4" aria-hidden="true" /> Add to doctor summary
+                </Link>
+              </div>
+            </section>
+          </article>
+        ) : (
+          <div className="h-[420px] rounded-[18px] border border-line bg-raised" aria-hidden="true" />
+        )}
+      </div>
+      )}
+    </div>
+  );
+}
