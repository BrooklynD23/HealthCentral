+/** Theme: explicit choice wins, otherwise follow the OS. Stored per device only. */
+export type ThemeChoice = 'light' | 'dark' | 'system';
+const KEY = 'asclexis-theme';
+
+export function resolveTheme(choice: ThemeChoice): 'light' | 'dark' {
+  if (choice !== 'system') return choice;
+  return window.matchMedia?.('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
+}
+
+export function readTheme(): ThemeChoice {
+  try {
+    const v = localStorage.getItem(KEY);
+    return v === 'light' || v === 'dark' ? v : 'system';
+  } catch {
+    return 'system';
+  }
+}
+
+export function applyTheme(choice: ThemeChoice) {
+  document.documentElement.dataset.theme = resolveTheme(choice);
+  try {
+    if (choice === 'system') localStorage.removeItem(KEY);
+    else localStorage.setItem(KEY, choice);
+  } catch {
+    /* storage unavailable: theme still applies for this session */
+  }
+}
+
+/** Motion tokens for JS-driven motion (mirrors tokens.css). */
+export const motionTokens = {
+  easeOutExpo: [0.23, 1, 0.32, 1] as const,
+  easeInOut: [0.77, 0, 0.175, 1] as const,
+  springSnappy: { type: 'spring' as const, visualDuration: 0.22, bounce: 0 },
+  springSettle: { type: 'spring' as const, visualDuration: 0.35, bounce: 0.1 },
+  staggerMs: 40,
+  staggerCap: 6,
+};
