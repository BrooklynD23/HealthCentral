@@ -0,0 +1,267 @@
+import { useEffect, useLayoutEffect, useRef, useState, type ComponentType } from 'react';
+import { NavLink, Outlet, useLocation } from 'react-router-dom';
+import {
+  Inbox,
+  ListChecks,
+  History,
+  Pin,
+  Activity,
+  MessageCircle,
+  Pill,
+  ClipboardList,
+  Send,
+  Settings,
+  Search,
+  Moon,
+  Sun,
+  MoreHorizontal,
+  ShieldCheck,
+} from 'lucide-react';
+import { MotionConfig } from 'motion/react';
+import { cn } from '@/utils/cn';
+import { CommandPalette } from './CommandPalette';
+import { applyTheme, readTheme, resolveTheme, type ThemeChoice } from './theme';
+
+type Item = { to: string; label: string; icon: ComponentType<{ className?: string }>; count?: number };
+type Group = { id: string; label: string | null; items: Item[] };
+
+export const NAV: Group[] = [
+  { id: 'records', label: 'Records', items: [
+    { to: '/inbox', label: 'Documents', icon: Inbox },
+    { to: '/verify', label: 'Review values', icon: ListChecks, count: 6 },
+    { to: '/timeline', label: 'Timeline', icon: History },
+    { to: '/pinboards', label: 'Pinboards', icon: Pin },
+  ] },
+  { id: 'understand', label: 'Understand', items: [
+    { to: '/results', label: 'Results', icon: Activity },
+    { to: '/explain', label: 'Ask', icon: MessageCircle },
+  ] },
+  { id: 'care', label: 'Care', items: [
+    { to: '/medications', label: 'Medications', icon: Pill },
+    { to: '/care-tasks', label: 'Follow-ups', icon: ClipboardList },
+  ] },
+  { id: 'share', label: 'Share', items: [{ to: '/export', label: 'Doctor summary', icon: Send }] },
+];
+
+const MOBILE_TABS: Item[] = [
+  { to: '/inbox', label: 'Records', icon: Inbox },
+  { to: '/results', label: 'Results', icon: Activity },
+  { to: '/explain', label: 'Ask', icon: MessageCircle },
+  { to: '/medications', label: 'Care', icon: Pill },
+];
+
+function isActivePath(pathname: string, to: string) {
+  return pathname === to || pathname.startsWith(`${to}/`);
+}
+
+function Sidebar({ pathname }: { pathname: string }) {
+  const navRef = useRef<HTMLElement>(null);
+  const [indicator, setIndicator] = useState<{ y: number; h: number } | null>(null);
+
+  // One CSS-transitioned indicator instead of a JS layout animation: it keeps
+  // running on the compositor while the next route chunk loads.
+  useLayoutEffect(() => {
+    const nav = navRef.current;
+    const active = nav?.querySelector<HTMLElement>('a[aria-current="page"]');
+    if (!nav || !active) return setIndicator(null);
+    setIndicator({ y: active.offsetTop, h: active.offsetHeight });
+  }, [pathname]);
+
+  return (
+    <aside className="hidden lg:flex fixed inset-y-0 left-0 w-[264px] flex-col border-r border-line bg-canvas/80 backdrop-blur-sm">
+      <div className="flex items-center gap-3 px-6 h-16">
+        <div className="grid size-8 place-items-center rounded-[10px] bg-brand text-on-brand" aria-hidden="true">
+          <svg viewBox="0 0 24 24" className="size-4" fill="none" stroke="currentColor" strokeWidth="2.4" strokeLinecap="round">
+            <path d="M3 12h4l2-5 4 10 2-5h6" />
+          </svg>
+        </div>
+        <span className="font-display text-[19px] font-semibold tracking-[-0.02em]">Asclexis</span>
+      </div>
+
+      <nav ref={navRef} aria-label="Main" className="relative flex-1 overflow-y-auto px-3 pb-4">
+        <span
+          aria-hidden="true"
+          className="nav-indicator pointer-events-none absolute left-3 right-3 top-0 rounded-[10px] bg-brand-wash"
+          style={{
+            height: indicator?.h ?? 44,
+            transform: `translateY(${indicator?.y ?? 0}px)`,
+            opacity: indicator ? 1 : 0,
+          }}
+        />
+        {NAV.map((group) => (
+          <div key={group.id} className="mt-5 first:mt-2">
+            {group.label && (
+              <p id={`nav-${group.id}`} className="px-3 pb-1.5 text-cap font-semibold text-fg-3">
+                {group.label}
+              </p>
+            )}
+            <ul aria-labelledby={group.label ? `nav-${group.id}` : undefined} className="space-y-0.5">
+              {group.items.map((item) => {
+                const active = isActivePath(pathname, item.to);
+                return (
+                  <li key={item.to}>
+                    <NavLink
+                      to={item.to}
+                      aria-current={active ? 'page' : undefined}
+                      className={cn(
+                        'pressable relative flex min-h-11 items-center gap-3 rounded-[10px] px-3 text-ui font-medium',
+                        active ? 'text-brand-ink' : 'text-fg-2 hover-lift hover:text-fg',
+                      )}
+                    >
+                      <item.icon className="size-[18px] shrink-0" />
+                      <span className="flex-1">{item.label}</span>
+                      {item.count ? (
+                        <span className="tnum rounded-full bg-caution-wash px-2 py-0.5 text-cap font-semibold text-caution">
+                          {item.count}
+                          <span className="sr-only"> values waiting for review</span>
+                        </span>
+                      ) : null}
+                    </NavLink>
+                  </li>
+                );
+              })}
+            </ul>
+          </div>
+        ))}
+      </nav>
+
+      <div className="border-t border-line p-3">
+        <NavLink
+          to="/settings"
+          className={({ isActive }) =>
+            cn('pressable flex min-h-11 items-center gap-3 rounded-[10px] px-3 text-ui font-medium',
+              isActive ? 'bg-brand-wash text-brand-ink' : 'text-fg-2 hover-lift hover:text-fg')
+          }
+        >
+          <Settings className="size-[18px]" />
+          Settings
+        </NavLink>
+        <div className="mt-2 flex items-center gap-3 rounded-[10px] px-3 py-2">
+          <span className="grid size-8 place-items-center rounded-full bg-well text-cap font-semibold text-fg-2" aria-hidden="true">
+            DT
+          </span>
+          <div className="min-w-0 flex-1">
+            <p className="truncate text-ui font-medium">Danny’s records</p>
+            <p className="flex items-center gap-1 text-cap text-fg-3">
+              <ShieldCheck className="size-3.5" aria-hidden="true" /> Encrypted on this device
+            </p>
+          </div>
+        </div>
+      </div>
+    </aside>
+  );
+}
+
+function ThemeButton({ choice, onToggle }: { choice: ThemeChoice; onToggle: () => void }) {
+  const dark = resolveTheme(choice) === 'dark';
+  return (
+    <button
+      type="button"
+      onClick={onToggle}
+      aria-label={dark ? 'Switch to light theme' : 'Switch to dark theme'}
+      className="pressable grid size-11 place-items-center rounded-[10px] text-fg-2 hover-lift hover:text-fg"
+    >
+      {dark ? <Sun className="size-[18px]" /> : <Moon className="size-[18px]" />}
+    </button>
+  );
+}
+
+export function Shell() {
+  const { pathname } = useLocation();
+  const [paletteOpen, setPaletteOpen] = useState(false);
+  const [theme, setTheme] = useState<ThemeChoice>(() => readTheme());
+
+  useEffect(() => applyTheme(theme), [theme]);
+
+  useEffect(() => {
+    const onKey = (e: KeyboardEvent) => {
+      const typing = e.target instanceof HTMLElement && e.target.closest('input, textarea, select, [contenteditable]');
+      if ((e.key === 'k' && (e.metaKey || e.ctrlKey)) || (e.key === '/' && !typing)) {
+        e.preventDefault();
+        setPaletteOpen((o) => !o);
+      }
+    };
+    window.addEventListener('keydown', onKey);
+    return () => window.removeEventListener('keydown', onKey);
+  }, []);
+
+  const toggleTheme = () => setTheme(resolveTheme(theme) === 'dark' ? 'light' : 'dark');
+
+  return (
+    <MotionConfig reducedMotion="user">
+      <a
+        href="#main"
+        className="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-[10px] focus:bg-raised focus:px-4 focus:py-3 focus:shadow-overlay"
+      >
+        Skip to content
+      </a>
+
+      <Sidebar pathname={pathname} />
+
+      <div className="min-h-dvh lg:pl-[264px] pb-[112px] lg:pb-0">
+        <header className="sticky top-0 z-30 flex h-16 items-center gap-3 border-b border-line bg-canvas/85 px-4 backdrop-blur-sm sm:px-6 lg:px-10">
+          <span className="font-display text-[19px] font-semibold tracking-[-0.02em] lg:hidden">Asclexis</span>
+          <button
+            type="button"
+            onClick={() => setPaletteOpen(true)}
+            className="pressable ml-auto hidden h-11 w-full max-w-[420px] items-center gap-3 rounded-[10px] border border-line bg-raised px-3.5 text-left text-ui text-fg-3 hover:border-line-strong lg:ml-0 lg:flex"
+          >
+            <Search className="size-4" aria-hidden="true" />
+            <span className="flex-1">Search records or jump to…</span>
+            <kbd className="rounded-md border border-line bg-well px-1.5 py-0.5 font-body text-cap text-fg-2">Ctrl K</kbd>
+          </button>
+          <div className="ml-auto flex items-center gap-1">
+            <button
+              type="button"
+              onClick={() => setPaletteOpen(true)}
+              aria-label="Search records or jump to a page"
+              className="pressable grid size-11 place-items-center rounded-[10px] text-fg-2 hover-lift lg:hidden"
+            >
+              <Search className="size-[18px]" />
+            </button>
+            <ThemeButton choice={theme} onToggle={toggleTheme} />
+          </div>
+        </header>
+
+        <main id="main" tabIndex={-1} className="mx-auto w-full max-w-[1240px] px-4 pb-16 pt-6 outline-none sm:px-6 lg:px-10 lg:pt-10">
+          {/* Enter-only route motion: the new page renders immediately; no exit, no blank gap. */}
+          <div key={pathname} className="route-in">
+            <Outlet />
+          </div>
+        </main>
+
+        {/* Safety rail: in the chrome, so no route animation ever touches it. */}
+        <p className="fixed inset-x-0 bottom-[64px] z-20 border-t border-line bg-canvas/95 px-4 py-1.5 text-center text-cap text-fg-2 lg:sticky lg:bottom-0 lg:py-2">
+          Educational only — not medical advice.<span className="hidden sm:inline"> Your records stay on this device.</span>
+        </p>
+      </div>
+
+      <nav aria-label="Main" className="fixed inset-x-0 bottom-0 z-30 grid h-16 grid-cols-5 border-t border-line bg-raised/95 backdrop-blur-sm lg:hidden">
+        {MOBILE_TABS.map((t) => {
+          const active = isActivePath(pathname, t.to);
+          return (
+            <NavLink
+              key={t.to}
+              to={t.to}
+              aria-current={active ? 'page' : undefined}
+              className={cn('pressable flex flex-col items-center justify-center gap-0.5 text-cap font-medium', active ? 'text-brand-ink' : 'text-fg-2')}
+            >
+              <t.icon className="size-5" />
+              {t.label}
+            </NavLink>
+          );
+        })}
+        <button
+          type="button"
+          onClick={() => setPaletteOpen(true)}
+          className="pressable flex flex-col items-center justify-center gap-0.5 text-cap font-medium text-fg-2"
+        >
+          <MoreHorizontal className="size-5" aria-hidden="true" />
+          More
+        </button>
+      </nav>
+
+      <CommandPalette open={paletteOpen} onOpenChange={setPaletteOpen} onToggleTheme={toggleTheme} />
+    </MotionConfig>
+  );
+}
