+/*
+ * Proposal B — "Quiet Instrument" tokens (prototype).
+ * Every text/background pair below is contrast-checked in proposal-B.md §3.
+ * Light/dark are composed separately, not inverted.
+ */
+
+@custom-variant dark (&:where([data-theme='dark'], [data-theme='dark'] *));
+
+:root {
+  color-scheme: light;
+  --c-canvas: #f8f7f3;
+  --c-raised: #ffffff;
+  --c-well: #f1efea;
+  --c-sunken: #e8e6e0;
+  --c-fg: #1b1d1a;
+  --c-fg-2: #4f534d;
+  --c-fg-3: #686c66;
+  --c-line: #dedbd3;
+  --c-line-strong: #8a8d85;
+  --c-brand: #1e6b5e;
+  --c-brand-ink: #185a4f;
+  --c-brand-wash: #e2f0ec;
+  --c-on-brand: #ffffff;
+  --c-band: #d9ebe5;
+  --c-inrange: #2e6a45;
+  --c-inrange-wash: #e7f2ea;
+  --c-outside: #94422f;
+  --c-outside-wash: #fbece7;
+  --c-caution: #7c5214;
+  --c-caution-wash: #faf0de;
+  --c-info: #2f5c86;
+  --c-info-wash: #e8f0f8;
+  --shadow-overlay: 0 1px 2px rgb(27 29 26 / 0.06), 0 12px 32px -12px rgb(27 29 26 / 0.22);
+  --shadow-modal: 0 2px 4px rgb(27 29 26 / 0.06), 0 32px 72px -24px rgb(27 29 26 / 0.34);
+  --glow: radial-gradient(1200px 600px at 12% -10%, rgb(30 107 94 / 0.07), transparent 60%);
+}
+
+:root[data-theme='dark'] {
+  color-scheme: dark;
+  --c-canvas: #111413;
+  --c-raised: #181c1a;
+  --c-well: #202523;
+  --c-sunken: #0c0e0d;
+  --c-fg: #eceee9;
+  --c-fg-2: #b9beb6;
+  --c-fg-3: #979d95;
+  --c-line: #2c322f;
+  --c-line-strong: #6e756f;
+  --c-brand: #6cc9b5;
+  --c-brand-ink: #7fd3c0;
+  --c-brand-wash: #17302a;
+  --c-on-brand: #06201a;
+  --c-band: #1c3a33;
+  --c-inrange: #93d6a8;
+  --c-inrange-wash: #16281d;
+  --c-outside: #f2a893;
+  --c-outside-wash: #33201a;
+  --c-caution: #e9c57e;
+  --c-caution-wash: #2e2615;
+  --c-info: #a3c6ec;
+  --c-info-wash: #172433;
+  --shadow-overlay: 0 0 0 1px rgb(255 255 255 / 0.04), 0 16px 40px -12px rgb(0 0 0 / 0.6);
+  --shadow-modal: 0 0 0 1px rgb(255 255 255 / 0.05), 0 40px 80px -24px rgb(0 0 0 / 0.7);
+  --glow: radial-gradient(1200px 600px at 12% -10%, rgb(108 201 181 / 0.06), transparent 60%);
+}
+
+@theme inline {
+  --color-canvas: var(--c-canvas);
+  --color-raised: var(--c-raised);
+  --color-well: var(--c-well);
+  --color-sunken: var(--c-sunken);
+  --color-fg: var(--c-fg);
+  --color-fg-2: var(--c-fg-2);
+  --color-fg-3: var(--c-fg-3);
+  --color-line: var(--c-line);
+  --color-line-strong: var(--c-line-strong);
+  --color-brand: var(--c-brand);
+  --color-brand-ink: var(--c-brand-ink);
+  --color-brand-wash: var(--c-brand-wash);
+  --color-on-brand: var(--c-on-brand);
+  --color-band: var(--c-band);
+  --color-inrange: var(--c-inrange);
+  --color-inrange-wash: var(--c-inrange-wash);
+  --color-outside: var(--c-outside);
+  --color-outside-wash: var(--c-outside-wash);
+  --color-caution: var(--c-caution);
+  --color-caution-wash: var(--c-caution-wash);
+  --color-info: var(--c-info);
+  --color-info-wash: var(--c-info-wash);
+  --shadow-overlay: var(--shadow-overlay);
+  --shadow-modal: var(--shadow-modal);
+}
+
+@theme {
+  /* Type scale (px at 16px root): 13 / 15 / 17 / 19 / 22 / 28 / 36 / 56 */
+  --text-cap: 0.8125rem;
+  --text-cap--line-height: 1.15rem;
+  --text-ui: 0.9375rem;
+  --text-ui--line-height: 1.35rem;
+  --text-body: 1.0625rem;
+  --text-body--line-height: 1.65rem;
+  --text-lead: 1.1875rem;
+  --text-lead--line-height: 1.75rem;
+  --text-h3: 1.375rem;
+  --text-h3--line-height: 1.75rem;
+  --text-h2: 1.75rem;
+  --text-h2--line-height: 2.1rem;
+  --text-h1: 2.25rem;
+  --text-h1--line-height: 2.5rem;
+  --text-numeral: 3.5rem;
+  --text-numeral--line-height: 1;
+
+  /* Motion tokens */
+  --ease-out-expo: cubic-bezier(0.23, 1, 0.32, 1);
+  --ease-in-out-strong: cubic-bezier(0.77, 0, 0.175, 1);
+  --ease-drawer: cubic-bezier(0.32, 0.72, 0, 1);
+  --dur-press: 120ms;
+  --dur-hover: 150ms;
+  --dur-sm: 180ms;
+  --dur-md: 240ms;
+  --dur-lg: 320ms;
+  --dur-draw: 640ms;
+}
+
+/* Theme-aware browser surfaces */
+html {
+  background: var(--c-canvas);
+}
+body {
+  background-color: var(--c-canvas) !important;
+  background-image: var(--glow) !important;
+  background-attachment: fixed;
+  color: var(--c-fg);
+}
+::selection {
+  background: var(--c-brand-wash);
+  color: var(--c-fg);
+}
+.tnum {
+  font-variant-numeric: tabular-nums lining-nums;
+}
+
+/* Press feedback: one frame, spring-like release via strong ease-out */
+.pressable {
+  transition:
+    transform var(--dur-press) var(--ease-out-expo),
+    background-color var(--dur-hover) ease,
+    color var(--dur-hover) ease,
+    border-color var(--dur-hover) ease;
+}
+.pressable:active {
+  transform: scale(0.97);
+}
+
+/* Route enter: no exit, no blank gap. Opacity + 6px rise, compositor-only. */
+@keyframes route-in {
+  from {
+    opacity: 0.35;
+    transform: translateY(6px);
+  }
+}
+.route-in {
+  animation: route-in var(--dur-md) var(--ease-out-expo) both;
+}
+
+/* Range ribbon: line reveal by clip-path, points settle after. */
+.ribbon-line {
+  clip-path: inset(0 0 0 0);
+}
+.ribbon-line[data-draw='true'] {
+  animation: ribbon-draw var(--dur-draw) var(--ease-out-expo) both;
+}
+@keyframes ribbon-draw {
+  from {
+    clip-path: inset(0 100% 0 0);
+  }
+}
+.ribbon-point[data-draw='true'] {
+  animation: point-in var(--dur-sm) var(--ease-out-expo) both;
+}
+@keyframes point-in {
+  from {
+    opacity: 0;
+    transform: scale(0.6);
+  }
+}
+.ribbon-point {
+  transform-box: fill-box;
+  transform-origin: center;
+}
+
+/* Provenance peek popover: scale from its trigger. */
+.peek {
+  transform-origin: var(--radix-popover-content-transform-origin);
+  animation: peek-in var(--dur-sm) var(--ease-out-expo);
+}
+.peek[data-state='closed'] {
+  animation: peek-out 120ms var(--ease-out-expo) forwards;
+}
+@keyframes peek-in {
+  from {
+    opacity: 0;
+    transform: scale(0.96);
+  }
+}
+@keyframes peek-out {
+  to {
+    opacity: 0;
+    transform: scale(0.98);
+  }
+}
+
+/* Nav indicator: CSS transform so it stays smooth while the next route loads. */
+.nav-indicator {
+  transition: transform var(--dur-md) var(--ease-out-expo), opacity var(--dur-sm) ease;
+}
+
+@media (hover: hover) and (pointer: fine) {
+  .hover-lift:hover {
+    background-color: var(--c-well);
+  }
+}
+
+/* Reduced motion: keep opacity, drop movement. Loaders keep feedback (opacity only). */
+@media (prefers-reduced-motion: reduce) {
+  .route-in {
+    animation: route-soft 120ms ease both;
+  }
+  .ribbon-line[data-draw='true'],
+  .ribbon-point[data-draw='true'] {
+    animation: route-fade 120ms ease both;
+  }
+  .peek,
+  .peek[data-state='closed'] {
+    animation: none;
+  }
+  .nav-indicator {
+    transition: opacity 120ms ease;
+  }
+  .pressable:active {
+    transform: none;
+  }
+}
+@keyframes route-soft {
+  from {
+    opacity: 0.35;
+  }
+}
+@keyframes route-fade {
+  from {
+    opacity: 0;
+  }
+}
