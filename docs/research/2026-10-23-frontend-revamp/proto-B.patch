index 0000000..9e2187e
--- /dev/null
+++ b/src/frontend/src/proto/CommandPalette.tsx
@@ -0,0 +1,83 @@
+import { Command } from 'cmdk';
+import { useNavigate } from 'react-router-dom';
+import { Activity, CornerDownLeft, Moon, Upload } from 'lucide-react';
+import { useObservations } from '@/services/observations';
+import { useAuthStore } from '@/stores/authStore';
+import { NAV } from './Shell';
+
+/**
+ * Opened 100+ times a day by keyboard users, so it has no open/close animation
+ * (Raycast rule). Highlight moves instantly too.
+ */
+export function CommandPalette({
+  open,
+  onOpenChange,
+  onToggleTheme,
+}: {
+  open: boolean;
+  onOpenChange: (o: boolean) => void;
+  onToggleTheme: () => void;
+}) {
+  const navigate = useNavigate();
+  const { profileId } = useAuthStore();
+  const { data: observations } = useObservations({ profile_id: profileId || '' });
+  const analytes = Array.from(new Map((observations ?? []).map((o) => [o.analyte_canonical, o.analyte_raw])).entries());
+
+  const go = (to: string) => {
+    onOpenChange(false);
+    navigate(to);
+  };
+
+  const itemClass =
+    'flex min-h-11 cursor-pointer items-center gap-3 rounded-[10px] px-3 text-ui text-fg data-[selected=true]:bg-brand-wash data-[selected=true]:text-brand-ink';
+
+  return (
+    <Command.Dialog
+      open={open}
+      onOpenChange={onOpenChange}
+      label="Search records or jump to a page"
+      overlayClassName="fixed inset-0 z-50 bg-[rgb(12_14_13/0.36)]"
+      contentClassName="fixed inset-x-3 top-[12vh] z-50 mx-auto max-w-[620px] overflow-hidden rounded-[20px] border border-line bg-raised shadow-modal"
+    >
+      <div className="flex items-center gap-3 border-b border-line px-4">
+        <Command.Input
+          autoFocus
+          placeholder="Search results, pages and actions…"
+          className="h-14 w-full bg-transparent text-body text-fg outline-none placeholder:text-fg-3 focus-visible:ring-0 focus-visible:ring-offset-0"
+        />
+      </div>
+      <Command.List className="max-h-[56vh] overflow-y-auto p-2">
+        <Command.Empty className="px-3 py-6 text-center text-ui text-fg-2">No matches in your records.</Command.Empty>
+        {analytes.length > 0 && (
+          <Command.Group heading="Results" className="[&_[cmdk-group-heading]]:px-3 [&_[cmdk-group-heading]]:py-2 [&_[cmdk-group-heading]]:text-cap [&_[cmdk-group-heading]]:font-semibold [&_[cmdk-group-heading]]:text-fg-3">
+            {analytes.map(([canonical, label]) => (
+              <Command.Item key={canonical} value={`result ${label}`} onSelect={() => go(`/results?analyte=${canonical}`)} className={itemClass}>
+                <Activity className="size-4 text-fg-3" aria-hidden="true" />
+                <span className="flex-1">{label}</span>
+                <CornerDownLeft className="size-3.5 text-fg-3" aria-hidden="true" />
+              </Command.Item>
+            ))}
+          </Command.Group>
+        )}
+        {NAV.map((g) => (
+          <Command.Group key={g.id} heading={g.label ?? ''} className="[&_[cmdk-group-heading]]:px-3 [&_[cmdk-group-heading]]:py-2 [&_[cmdk-group-heading]]:text-cap [&_[cmdk-group-heading]]:font-semibold [&_[cmdk-group-heading]]:text-fg-3">
+            {g.items.map((i) => (
+              <Command.Item key={i.to} value={`go ${i.label}`} onSelect={() => go(i.to)} className={itemClass}>
+                <i.icon className="size-4 text-fg-3" />
+                {i.label}
+              </Command.Item>
+            ))}
+          </Command.Group>
+        ))}
+        <Command.Group heading="Actions" className="[&_[cmdk-group-heading]]:px-3 [&_[cmdk-group-heading]]:py-2 [&_[cmdk-group-heading]]:text-cap [&_[cmdk-group-heading]]:font-semibold [&_[cmdk-group-heading]]:text-fg-3">
+          <Command.Item value="import a document" onSelect={() => go('/inbox')} className={itemClass}>
+            <Upload className="size-4 text-fg-3" aria-hidden="true" /> Import a document
+          </Command.Item>
+          <Command.Item value="switch theme dark light" onSelect={() => { onToggleTheme(); onOpenChange(false); }} className={itemClass}>
+            <Moon className="size-4 text-fg-3" aria-hidden="true" /> Switch light / dark
+          </Command.Item>
+        </Command.Group>
+      </Command.List>
+    </Command.Dialog>
+  );
+}
