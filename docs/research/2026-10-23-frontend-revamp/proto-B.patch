+import { useMemo } from 'react';
+import { Link, useSearchParams } from 'react-router-dom';
+import { ArrowDown, ArrowUp, Check, CircleDashed, MessageCircle, Send } from 'lucide-react';
+import { useObservations, useTrend } from '@/services/observations';
+import { useAuthStore } from '@/stores/authStore';
+import type { Observation } from '@/services/types';
+import { cn } from '@/utils/cn';
+import { RangeRibbon, rangeState } from './RangeRibbon';
+import { ProvenancePeek } from './ProvenancePeek';
+
+const longDate = (iso: string) =>
+  new Date(`${iso.slice(0, 10)}T12:00:00`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
+
+function rangeLabel(low: number | null, high: number | null) {
+  if (low !== null && high !== null) return `${low}–${high}`;
+  if (high !== null) return `up to ${high}`;
+  if (low !== null) return `${low} or more`;
+  return 'not printed';
+}
+
+function RangeChip({ value, low, high, size = 'md' }: { value: number; low: number | null; high: number | null; size?: 'sm' | 'md' }) {
+  const s = rangeState(value, low, high);
+  const Icon = s === 'above' ? ArrowUp : s === 'below' ? ArrowDown : Check;
+  const text = s === 'above' ? 'Above report range' : s === 'below' ? 'Below report range' : 'Within report range';
+  return (
+    <span
+      className={cn(
+        'inline-flex items-center gap-1.5 rounded-full font-semibold',
+        size === 'md' ? 'px-3 py-1 text-ui' : 'px-2 py-0.5 text-cap',
+        s === 'within' ? 'bg-inrange-wash text-inrange' : 'bg-outside-wash text-outside',
+      )}
+    >
+      <Icon className={size === 'md' ? 'size-4' : 'size-3.5'} aria-hidden="true" strokeWidth={2.5} />
+      {text}
+    </span>
+  );
+}
+
+/** A 64px glyph: where the latest value sits against the printed range. Shape, not colour. */
+function RangeTick({ value, low, high }: { value: number; low: number | null; high: number | null }) {
+  const lo = Math.min(value, low ?? value) - Math.abs(value) * 0.25;
+  const hi = Math.max(value, high ?? value) + Math.abs(value) * 0.25;
+  const x = (v: number) => 4 + ((v - lo) / (hi - lo || 1)) * 56;
+  return (
+    <svg width="64" height="14" viewBox="0 0 64 14" aria-hidden="true" className="shrink-0">
+      <rect x="4" y="6" width="56" height="2" rx="1" className="fill-sunken" />
+      <rect x={x(low ?? lo)} y="3" width={Math.max(2, x(high ?? hi) - x(low ?? lo))} height="8" rx="4" className="fill-band" />
+      <circle cx={x(value)} cy="7" r="4" className="fill-brand stroke-raised" strokeWidth="1.5" />
+    </svg>
+  );
+}
+
+export function ResultsPage() {
+  const { profileId } = useAuthStore();
+  const [params, setParams] = useSearchParams();
+  const { data: observations, isLoading } = useObservations({ profile_id: profileId || '' });
+
+  const latestByAnalyte = useMemo(() => {
+    const m = new Map<string, Observation>();
+    for (const o of observations ?? []) {
+      const prev = m.get(o.analyte_canonical);
+      if (!prev || (o.collected_at ?? '') > (prev.collected_at ?? '')) m.set(o.analyte_canonical, o);
+    }
+    return Array.from(m.values());
+  }, [observations]);
+
+  const selected = params.get('analyte') ?? latestByAnalyte[0]?.analyte_canonical;
+  const { data: trend } = useTrend(selected);
+  const latest = latestByAnalyte.find((o) => o.analyte_canonical === selected);
+  const select = (c: string) => setParams({ analyte: c }, { replace: true });
+
+  const pts = trend?.data_points ?? [];
+  const first = pts[0];
+  const last = pts[pts.length - 1];
+  const docTitle = (latest as (Observation & { source_doc_title?: string }) | undefined)?.source_doc_title ?? 'Lab report';
+
+  return (
+    <div className="space-y-8">
+      <header className="max-w-[46rem]">
+        <h1 className="font-display text-h2 font-semibold tracking-[-0.025em] sm:text-h1">Results</h1>
+        <p className="mt-2 text-body text-fg-2">
+          Values from your imported lab reports, drawn against the reference range each lab printed.
+        </p>
+      </header>
+
+      {isLoading || (selected && !trend) ? (
+        <div role="status" aria-live="polite" className="grid grid-cols-[minmax(0,1fr)] gap-6 lg:grid-cols-[300px_minmax(0,1fr)] lg:gap-8">
+          <div className="hidden h-[440px] rounded-[14px] bg-well lg:block" />
+          <div className="h-[760px] rounded-[18px] bg-well" />
+          <span className="sr-only">Loading results…</span>
+        </div>
+      ) : (
+      <div className="grid grid-cols-[minmax(0,1fr)] gap-6 lg:grid-cols-[300px_minmax(0,1fr)] lg:gap-8">
+        {/* Analyte picker: rail on desktop, scrollable chips on phones (scrolls inside itself) */}
+        <nav aria-label="Analytes" className="lg:sticky lg:top-24 lg:self-start">
+          <ul className="-mx-4 flex gap-2 overflow-x-auto px-4 pb-1 lg:mx-0 lg:block lg:space-y-1 lg:overflow-visible lg:px-0">
+            {latestByAnalyte.map((o) => {
+              const active = o.analyte_canonical === selected;
+              return (
+                <li key={o.analyte_canonical} className="shrink-0">
+                  <button
+                    type="button"
+                    onClick={() => select(o.analyte_canonical)}
+                    aria-current={active ? 'true' : undefined}
+                    className={cn(
+                      'pressable flex min-h-11 w-full items-center gap-3 rounded-[12px] border px-3 py-2 text-left',
+                      active ? 'border-brand/40 bg-brand-wash' : 'border-line bg-raised hover-lift lg:border-transparent lg:bg-transparent',
+                    )}
+                  >
+                    <span className="min-w-0 flex-1">
+                      <span className={cn('block whitespace-nowrap text-ui font-semibold', active ? 'text-brand-ink' : 'text-fg')}>
+                        {o.analyte_raw}
+                      </span>
+                      <span className="tnum block whitespace-nowrap text-cap text-fg-2">
+                        {o.value} {o.unit}
+                        {o.value !== null && rangeState(o.value, o.ref_low, o.ref_high) !== 'within' && (
+                          <span className="ml-1.5 text-outside">
+                            · {rangeState(o.value, o.ref_low, o.ref_high) === 'above' ? 'above range' : 'below range'}
+                          </span>
+                        )}
+                      </span>
+                    </span>
+                    {o.value !== null && (
+                      <span className="hidden lg:block">
+                        <RangeTick value={o.value} low={o.ref_low} high={o.ref_high} />
+                      </span>
+                    )}
+                  </button>
+                </li>
+              );
+            })}
+          </ul>
+        </nav>
+
+        {latest && trend && last ? (
+          <article aria-labelledby="result-title" className="rounded-[18px] border border-line bg-raised p-5 sm:p-8">
+            <div className="flex flex-wrap items-start justify-between gap-x-6 gap-y-3">
+              <div>
+                <h2 id="result-title" className="font-display text-h3 font-semibold tracking-[-0.02em] sm:text-h2">
+                  {trend.analyte_display_name}
+                </h2>
+                <p className="mt-1 text-ui text-fg-2">
+                  Latest result · {longDate(last.date)} · {docTitle}
+                </p>
+              </div>
+              {last.user_verified ? (
+                <span className="inline-flex items-center gap-1.5 rounded-full bg-well px-3 py-1 text-ui font-medium text-fg-2">
+                  <Check className="size-4" aria-hidden="true" /> Checked by you
+                </span>
+              ) : (
+                <Link to="/verify" className="pressable inline-flex min-h-11 items-center gap-1.5 rounded-full bg-caution-wash px-3 text-ui font-semibold text-caution">
+                  <CircleDashed className="size-4" aria-hidden="true" /> Not yet checked · Review
+                </Link>
+              )}
+            </div>
+
+            <div className="mt-6 flex flex-wrap items-end gap-x-5 gap-y-3">
+              <p className="tnum font-display text-numeral font-medium tracking-[-0.03em]">
+                {last.value}
+                <span className="ml-2 font-body text-lead font-normal tracking-normal text-fg-2">{trend.unit}</span>
+              </p>
+              <div className="flex flex-col gap-1.5 pb-1.5">
+                <RangeChip value={last.value} low={trend.ref_low} high={trend.ref_high} />
+                <span className="tnum text-ui text-fg-2">
+                  Report range {rangeLabel(trend.ref_low, trend.ref_high)} {trend.unit}
+                </span>
+              </div>
+            </div>
+
+            <div className="mt-6 -mx-1">
+              <RangeRibbon
+                id={trend.analyte_canonical}
+                label={trend.analyte_display_name}
+                points={pts.map((p) => ({ date: p.date, value: p.value, verified: p.user_verified === true }))}
+                low={trend.ref_low}
+                high={trend.ref_high}
+                unit={trend.unit}
+              />
+            </div>
+
+            <section aria-labelledby="says-title" className="mt-6 border-t border-line pt-6">
+              <h3 id="says-title" className="font-body text-ui font-semibold tracking-normal text-fg">What your reports show</h3>
+              <p className="tnum mt-2 max-w-[62ch] text-body text-fg">
+                Your {trend.analyte_display_name} result on {longDate(last.date)} was {last.value} {trend.unit}
+                <sup className="ml-0.5 text-cap text-fg-2">[1]</sup>. The range printed on that report is {rangeLabel(trend.ref_low, trend.ref_high)} {trend.unit}.
+                {pts.length > 1 && first && (
+                  <> Across {pts.length} results since {longDate(first.date)}, it went from {first.value} to {last.value} {trend.unit}<sup className="ml-0.5 text-cap text-fg-2">[2]</sup>.</>
+                )}
+              </p>
+              <div className="mt-3 flex flex-wrap gap-2">
+                <ProvenancePeek n={1} docTitle={docTitle} page={latest.source_page ?? 1}
+                  quote={`${latest.analyte_raw}  ${last.value} ${trend.unit}  (${latest.ref_range_text ?? rangeLabel(trend.ref_low, trend.ref_high)})`}
