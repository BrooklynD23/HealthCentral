@@ -0,0 +1,300 @@
+import { useMemo, useState } from 'react';
+import { Link, useSearchParams } from 'react-router-dom';
+import { toast } from 'sonner';
+import { ArrowDown, ArrowUp, Circle, FileSearch, PencilLine, CheckCheck, MessageCircle, Info } from 'lucide-react';
+import { cn } from '@/utils/cn';
+import { RangeRibbon } from '@/components/results/RangeRibbon';
+import { ProvenanceSheet } from '@/components/results/ProvenanceSheet';
+import {
+  analytes as seed,
+  fmtDate,
+  rangeStatus,
+  rangeText,
+  statusText,
+  type Analyte,
+  type RangeStatus,
+} from '@/components/results/fixtures';
+
+function StatusLine({ status, short = false }: { status: RangeStatus; short?: boolean }) {
+  const Icon = status === 'above' ? ArrowUp : status === 'below' ? ArrowDown : Circle;
+  const label = short
+    ? { above: 'Above range', below: 'Below range', within: 'In range', unknown: 'No range' }[status]
+    : statusText[status];
+  return (
+    <span
+      className={cn(
+        'inline-flex items-center gap-1.5',
+        status === 'above' || status === 'below' ? 'text-status-attention' : 'text-ink-secondary'
+      )}
+    >
+      <Icon className={cn('shrink-0', status === 'within' || status === 'unknown' ? 'h-2.5 w-2.5' : 'h-4 w-4')} aria-hidden strokeWidth={2.5} />
+      {label}
+    </span>
+  );
+}
+
+const panels: Analyte['panel'][] = ['Metabolic', 'Lipids', 'Blood count', 'Thyroid'];
+
+export function ResultsPage() {
+  const [params, setParams] = useSearchParams();
+  const [data, setData] = useState<Analyte[]>(seed);
+  const analyteId = params.get('analyte') ?? data[0].id;
+  const analyte = data.find((a) => a.id === analyteId) ?? data[0];
+  const [selectedBy, setSelectedBy] = useState<Record<string, number>>({});
+  const selected = selectedBy[analyte.id] ?? analyte.points.length - 1;
+  const point = analyte.points[selected];
+  const status = rangeStatus(point.value, analyte.refLow, analyte.refHigh);
+  const [sourceOpen, setSourceOpen] = useState(false);
+
+  const pencilCount = useMemo(() => data.reduce((n, a) => n + a.points.filter((p) => !p.verified).length, 0), [data]);
+  const first = analyte.points[0];
+
+  const setVerified = (aid: string, idx: number, verified: boolean) =>
+    setData((d) =>
+      d.map((a) => (a.id !== aid ? a : { ...a, points: a.points.map((p, i) => (i === idx ? { ...p, verified } : p)) }))
+    );
+
+  const verify = () => {
+    const aid = analyte.id;
+    const idx = selected;
+    setVerified(aid, idx, true);
+    setSourceOpen(false);
+    toast(`${analyte.name}, ${fmtDate(point.date)} is now verified.`, {
+      description: 'It is drawn in ink on every chart.',
+      action: { label: 'Undo', onClick: () => setVerified(aid, idx, false) },
+    });
+  };
+
+  const choose = (id: string) => setParams({ analyte: id }, { replace: true });
+
+  return (
+    <div className="space-y-6">
+      <header className="flex flex-wrap items-end justify-between gap-4">
+        <div>
+          <h1 className="text-[2rem] leading-tight text-ink sm:text-[2.375rem]">Results</h1>
+          <p className="mt-1 max-w-[60ch] text-base text-ink-secondary">
+            What your reports say, over time. Checked values are drawn in ink; values you haven’t checked yet are in pencil.
+          </p>
+        </div>
+        {pencilCount > 0 && (
+          <Link
+            to="/verify"
+            className="pressable inline-flex min-h-[44px] items-center gap-2 rounded-[10px] border border-line bg-surface-elevated px-4 text-[0.9375rem] font-semibold text-ink hover:border-line-strong"
+          >
+            <PencilLine className="h-4 w-4 text-pencil" aria-hidden />
+            {pencilCount} {pencilCount === 1 ? 'value' : 'values'} in pencil
+            <span className="text-accent-ink">Review</span>
+          </Link>
+        )}
+      </header>
+
+      {/* Phone/tablet: analyte picker scrolls inside itself, never the page */}
+      <div className="-mx-4 overflow-x-auto px-4 pb-1 lg:hidden" role="group" aria-label="Choose a result">
+        <div className="flex w-max gap-2">
+          {data.map((a) => {
+            const active = a.id === analyte.id;
+            return (
+              <button
+                key={a.id}
+                aria-pressed={active}
+                onClick={() => choose(a.id)}
+                className={cn(
+                  'pressable min-h-[44px] rounded-full border px-4 text-[0.9375rem] font-medium',
+                  active ? 'border-accent bg-accent-subtle text-accent-ink' : 'border-line bg-surface-elevated text-ink-secondary'
+                )}
+              >
+                {a.name}
+              </button>
+            );
+          })}
+        </div>
+      </div>
+
+      <div className="grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_300px]">
+        <section
+          aria-labelledby="analyte-title"
+          className="min-w-0 rounded-[16px] border border-line bg-surface-elevated shadow-[var(--shadow-1)]"
+        >
+          <div className="flex flex-wrap items-start justify-between gap-x-6 gap-y-4 px-5 pt-5 sm:px-7 sm:pt-6">
+            <div className="min-w-0">
+              <p className="text-sm font-semibold text-ink-tertiary">
+                {analyte.panel} · reference {rangeText(analyte)}
+              </p>
+              <h2 id="analyte-title" className="mt-0.5 text-[1.75rem] leading-tight text-ink">
+                {analyte.name}
+              </h2>
+            </div>
+            {/* Readout: the selected point. Numbers swap instantly, never count up. */}
+            <div className="min-w-0 text-left sm:text-right" aria-live="polite">
+              <p className="tabular text-[2.5rem] font-semibold leading-none tracking-tight text-ink">
+                {point.value}
+                <span className="ml-1.5 text-lg font-medium text-ink-secondary">{analyte.unit}</span>
+              </p>
+              <p className="mt-2 text-[0.9375rem] text-ink-secondary">{fmtDate(point.date)}</p>
+            </div>
+          </div>
+
+          <div className="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 px-5 text-[0.9375rem] sm:px-7">
+            <StatusLine status={status} />
+            {point.verified ? (
+              <span className="inline-flex items-center gap-1.5 text-status-verified">
+                <CheckCheck className="h-4 w-4" aria-hidden /> Verified by you
+              </span>
+            ) : (
+              <span className="inline-flex items-center gap-1.5 text-ink-secondary">
+                <PencilLine className="h-4 w-4 text-pencil" aria-hidden /> In pencil
+              </span>
+            )}
+            <button
+              type="button"
+              onClick={() => setSourceOpen(true)}
+              className="pressable ml-auto inline-flex min-h-[44px] items-center gap-2 rounded-[10px] px-3 font-semibold text-accent-ink hover:bg-accent-subtle"
+            >
+              <FileSearch className="h-4 w-4" aria-hidden /> Show source
+            </button>
+          </div>
+
+          {/* Legend explains every shape, so nothing depends on colour alone. */}
+          <ul className="mt-3 flex flex-wrap gap-x-5 gap-y-1.5 px-5 text-sm text-ink-secondary sm:px-7" aria-label="Chart key">
+            <li className="inline-flex items-center gap-2">
+              <span className="h-3 w-5 rounded-[3px] bg-band" aria-hidden /> Reference range (per report)
+            </li>
+            <li className="inline-flex items-center gap-2">
+              <svg width="12" height="12" aria-hidden><circle cx="6" cy="6" r="4.5" fill="var(--accent)" /></svg> Verified (ink)
+            </li>
+            <li className="inline-flex items-center gap-2">
+              <svg width="12" height="12" aria-hidden><circle cx="6" cy="6" r="4.5" fill="none" stroke="var(--pencil)" strokeWidth="1.5" strokeDasharray="2.4 2.4" /></svg> Not yet checked (pencil)
+            </li>
+            <li className="inline-flex items-center gap-2">
+              <svg width="10" height="10" aria-hidden><path d="M1 9 L9 9 L5 2 Z" fill="var(--outside)" /></svg> Outside range
+            </li>
+          </ul>
+
+          <div className="px-3 pt-1 sm:px-5">
+            <RangeRibbon
+              key={analyte.id}
+              analyte={analyte}
+              selected={selected}
+              onSelect={(i) => setSelectedBy((s) => ({ ...s, [analyte.id]: i }))}
+              height={260}
+            />
+          </div>
+
+          <div className="space-y-3 px-5 pb-5 sm:px-7">
+            <p className="text-[0.9375rem] text-ink-secondary">
+              {analyte.points.length} results since {fmtDate(first.date, { month: 'short', year: 'numeric' })}, from {first.value} to{' '}
+              {analyte.points[analyte.points.length - 1].value} {analyte.unit}. Use ← → to step through them.
+            </p>
+            <details className="group rounded-[10px] border border-line">
+              <summary className="flex min-h-[44px] cursor-pointer items-center px-4 text-[0.9375rem] font-semibold text-ink">
+                Show as a table
+              </summary>
+              <div className="overflow-x-auto px-4 pb-3">
+                <table className="w-full text-left text-[0.9375rem]">
+                  <thead className="text-sm text-ink-tertiary">
+                    <tr>
+                      <th className="py-2 font-semibold">Date</th>
+                      <th className="py-2 font-semibold">Result</th>
+                      <th className="py-2 font-semibold">Range</th>
+                      <th className="py-2 font-semibold">Checked</th>
+                    </tr>
+                  </thead>
+                  <tbody>
+                    {analyte.points.map((p, i) => (
+                      <tr key={i} className="border-t border-line">
+                        <td className="py-2">{fmtDate(p.date)}</td>
+                        <td className="tabular py-2 font-semibold">{p.value} {analyte.unit}</td>
+                        <td className="py-2"><StatusLine short status={rangeStatus(p.value, analyte.refLow, analyte.refHigh)} /></td>
+                        <td className="py-2">{p.verified ? 'Verified' : 'In pencil'}</td>
+                      </tr>
+                    ))}
+                  </tbody>
+                </table>
+              </div>
+            </details>
+          </div>
+
+          {/* Safety zone: never animated, never hover-only. */}
+          <p className="flex items-start gap-2 rounded-b-[16px] border-t border-line bg-surface-muted px-5 py-3 text-sm text-ink-secondary sm:px-7">
+            <Info className="mt-0.5 h-4 w-4 shrink-0" aria-hidden />
+            Educational information from your own records, not medical advice. A result outside the report’s range is something to
+            discuss with your clinician, not a diagnosis.
+          </p>
+        </section>
+
+        <aside className="hidden space-y-4 lg:block" aria-label="All results">
+          <nav className="overflow-hidden rounded-[16px] border border-line bg-surface-elevated">
+            {panels.map((panel) => {
+              const list = data.filter((a) => a.panel === panel);
+              if (!list.length) return null;
+              return (
+                <div key={panel}>
+                  <p className="border-b border-line bg-surface-muted/60 px-4 py-2 text-xs font-semibold uppercase tracking-[0.06em] text-ink-tertiary">
+                    {panel}
+                  </p>
+                  <ul>
+                    {list.map((a) => {
+                      const last = a.points[a.points.length - 1];
+                      const active = a.id === analyte.id;
+                      const pencil = a.points.filter((p) => !p.verified).length;
+                      return (
+                        <li key={a.id} className="border-b border-line last:border-b-0">
+                          <button
+                            type="button"
+                            onClick={() => choose(a.id)}
+                            aria-current={active ? 'true' : undefined}
+                            className={cn(
+                              'flex min-h-[60px] w-full items-center gap-3 px-4 py-2.5 text-left transition-colors duration-150',
+                              active ? 'bg-accent-subtle' : 'hover:bg-surface-muted'
+                            )}
+                          >
+                            <span className="min-w-0 flex-1">
+                              <span className={cn('block truncate text-[0.9375rem] font-semibold', active ? 'text-accent-ink' : 'text-ink')}>
+                                {a.name}
+                              </span>
+                              <span className="mt-0.5 flex items-center gap-2 text-sm">
+                                <StatusLine short status={rangeStatus(last.value, a.refLow, a.refHigh)} />
+                                {pencil > 0 && (
+                                  <span className="inline-flex items-center gap-1 text-ink-tertiary">
+                                    <PencilLine className="h-3.5 w-3.5" aria-hidden /> {pencil}
+                                  </span>
+                                )}
+                              </span>
+                            </span>
+                            <span className="tabular text-right text-[0.9375rem] font-semibold text-ink">
+                              {last.value}
+                              <span className="block text-xs font-normal text-ink-tertiary">{a.unit}</span>
+                            </span>
+                          </button>
+                        </li>
+                      );
+                    })}
+                  </ul>
+                </div>
+              );
+            })}
+          </nav>
+
+          <Link
+            to={`/explain?q=${encodeURIComponent(`What does my ${analyte.name.toLowerCase()} history show?`)}`}
+            className="pressable flex min-h-[56px] items-center gap-3 rounded-[16px] border border-line bg-surface-elevated px-4 text-[0.9375rem] font-semibold text-ink hover:border-line-strong"
+          >
+            <MessageCircle className="h-5 w-5 text-accent" aria-hidden />
+            Ask about your {analyte.name.toLowerCase()} history
+          </Link>
+        </aside>
+      </div>
+
+      <ProvenanceSheet open={sourceOpen} onOpenChange={setSourceOpen} analyte={analyte} point={point} onVerify={verify} />
+    </div>
+  );
+}
+
+export function OverviewPlaceholder() {
+  return (
+    <div className="space-y-2">
+      <h1 className="text-[2.375rem] text-ink">Overview</h1>
+      <p className="text-ink-secondary">Planned in row FE-C1. The prototype proves the shell and the Results screen.</p>
+    </div>
+  );
+}
