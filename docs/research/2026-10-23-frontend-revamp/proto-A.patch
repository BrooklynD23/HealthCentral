diff --git a/src/frontend/src/motion/MotionProvider.tsx b/src/frontend/src/motion/MotionProvider.tsx
new file mode 100644
index 0000000..563cbf1
--- /dev/null
+++ b/src/frontend/src/motion/MotionProvider.tsx
@@ -0,0 +1,18 @@
+import type { ReactNode } from 'react';
+import { LazyMotion, MotionConfig } from 'motion/react';
+
+// Feature bundle loads after first paint: initial cost ~9 kB gz instead of ~36 kB.
+const loadFeatures = () => import('./features').then((m) => m.default);
+
+/**
+ * reducedMotion="user": transform/layout animations are dropped when the OS asks,
+ * opacity and colour keep running. Replaces the hand-rolled useReducedMotion hook,
+ * which initialised to false and animated the first render (audit §2a).
+ */
+export function MotionProvider({ children }: { children: ReactNode }) {
+  return (
+    <LazyMotion features={loadFeatures} strict>
+      <MotionConfig reducedMotion="user">{children}</MotionConfig>
+    </LazyMotion>
+  );
+}
