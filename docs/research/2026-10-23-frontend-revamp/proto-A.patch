+/**
+ * Motion tokens (mirror of the CSS custom properties in globals.css).
+ * One easing family; durations in seconds for Motion, ms in CSS.
+ *
+ * Zones (the reconciliation rule):
+ *  - chrome: nav, overlays, toasts, palette — springs and transforms allowed.
+ *  - data:   lab values, charts — opacity and clip-path only, once per view;
+ *            numbers never tween.
+ *  - safety: disclaimers, citations, range status — never animated.
+ */
+export const ease = {
+  out: [0.23, 1, 0.32, 1] as const,
+  inOut: [0.77, 0, 0.175, 1] as const,
+  drawer: [0.32, 0.72, 0, 1] as const,
+};
+
+export const dur = {
+  press: 0.12,
+  hover: 0.15,
+  small: 0.18,
+  route: 0.18,
+  overlay: 0.24,
+  overlayExit: 0.16,
+  sheet: 0.32,
+  ink: 0.36,
+  reveal: 0.64,
+};
+
+export const spring = {
+  snappy: { type: 'spring', visualDuration: 0.25, bounce: 0.12 } as const,
+  sheet: { type: 'spring', visualDuration: 0.35, bounce: 0 } as const,
+};
+
+/** Stagger between list items, and the cap on total stagger. */
+export const stagger = { each: 0.04, maxItems: 6 };
