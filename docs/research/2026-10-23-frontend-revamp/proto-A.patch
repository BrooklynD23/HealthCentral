@@ -0,0 +1,68 @@
+import {
+  LayoutGrid,
+  FileText,
+  CheckCheck,
+  History,
+  LineChart,
+  MessageCircle,
+  Pill,
+  ClipboardList,
+  Pin,
+  FileOutput,
+  type LucideIcon,
+} from 'lucide-react';
+
+export interface NavItem {
+  to: string;
+  label: string;
+  icon: LucideIcon;
+  /** Extra path prefixes that keep this item active (e.g. /medications/:id). */
+  match?: string[];
+}
+export interface NavGroup {
+  label: string | null;
+  items: NavItem[];
+}
+
+/**
+ * 12 flat items -> 4 named groups + Overview (9 destinations). Alerts moves into
+ * Medications (reminders) and Settings; Interpret merges into Results; Settings
+ * lives in the profile menu. Labels are plain nouns, no "smart" names.
+ */
+export const navGroups: NavGroup[] = [
+  { label: null, items: [{ to: '/overview', label: 'Overview', icon: LayoutGrid }] },
+  {
+    label: 'Records',
+    items: [
+      { to: '/inbox', label: 'Documents', icon: FileText },
+      { to: '/verify', label: 'Review', icon: CheckCheck },
+      { to: '/timeline', label: 'Timeline', icon: History },
+    ],
+  },
+  {
+    label: 'Understand',
+    items: [
+      { to: '/results', label: 'Results', icon: LineChart, match: ['/trends', '/interpret'] },
+      { to: '/explain', label: 'Ask', icon: MessageCircle },
+    ],
+  },
+  {
+    label: 'Care',
+    items: [
+      { to: '/medications', label: 'Medications', icon: Pill, match: ['/notifications'] },
+      { to: '/care-tasks', label: 'Tasks', icon: ClipboardList },
+      { to: '/pinboards', label: 'Pinboards', icon: Pin },
+    ],
+  },
+  { label: 'Share', items: [{ to: '/export', label: 'Doctor summary', icon: FileOutput }] },
+];
+
+export const allNavItems = navGroups.flatMap((g) => g.items);
+
+export function isItemActive(item: NavItem, pathname: string) {
+  const prefixes = [item.to, ...(item.match ?? [])];
+  return prefixes.some((p) => pathname === p || pathname.startsWith(p + '/'));
+}
+
+/** Mobile tab bar: the four most-used destinations + More. */
+export const mobileTabs = ['/overview', '/results', '/inbox', '/explain'];
