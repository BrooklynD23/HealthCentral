+
+/**
+ * Profile identity in the chrome (audit: none existed). "Lock now" is drawn but
+ * disabled in the prototype: the unlock flow is an owner gate (auth).
+ */
+export function ProfileMenu({ compact = false }: { compact?: boolean }) {
+  const navigate = useNavigate();
+  const name = useAuthStore((s) => s.profileName) ?? 'Profile';
+  const { pref, setPref } = useTheme();
+  const themes: { v: ThemePref; label: string; icon: typeof Sun }[] = [
+    { v: 'light', label: 'Light', icon: Sun },
+    { v: 'dark', label: 'Dark', icon: Moon },
+    { v: 'system', label: 'Match system', icon: Monitor },
+  ];
+
+  return (
