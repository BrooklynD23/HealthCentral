@@ -0,0 +1,130 @@
+import * as Dialog from '@radix-ui/react-dialog';
+import { FileText, X, CheckCheck, PencilLine } from 'lucide-react';
+import { fmtDate, rangeText, type Analyte, type ResultPoint } from './fixtures';
+
+/**
+ * SOURCE TRACE (signature moment 3): any value opens the exact row it came from.
+ * Side sheet on desktop, bottom sheet on phones. Built on Radix Dialog for focus
+ * trap, Escape, focus return and aria-modal (audit: none of the 6 overlays had them).
+ */
+interface Props {
+  open: boolean;
+  onOpenChange: (o: boolean) => void;
+  analyte: Analyte;
+  point: ResultPoint;
+  onVerify: () => void;
+}
+
+export function ProvenanceSheet({ open, onOpenChange, analyte, point, onVerify }: Props) {
+  const { source } = point;
+  const rowIndex = source.row - 2;
+  return (
+    <Dialog.Root open={open} onOpenChange={onOpenChange}>
+      <Dialog.Portal>
+        <Dialog.Overlay className="scrim fixed inset-0 z-50 bg-[var(--scrim)]" />
+        <Dialog.Content
+          className={[
+            'fixed z-50 flex flex-col bg-surface-elevated shadow-[var(--shadow-3)] outline-none',
+            // phone: bottom sheet
+            'sheet-responsive inset-x-0 bottom-0 max-h-[88dvh] rounded-t-[20px] border-t border-line',
+            // desktop: side sheet
+            'sm:inset-y-3 sm:left-auto sm:right-3 sm:bottom-3 sm:max-h-none sm:w-[440px] sm:rounded-[16px] sm:border',
+          ].join(' ')}
+        >
+          <div className="flex items-start justify-between gap-4 border-b border-line px-6 pb-4 pt-5">
+            <div>
+              <Dialog.Title className="text-lg font-semibold text-ink">Where this number came from</Dialog.Title>
+              <Dialog.Description className="mt-0.5 text-sm text-ink-secondary">
+                This is what your report states.
+              </Dialog.Description>
+            </div>
+            <Dialog.Close
+              className="pressable -mr-2 grid h-11 w-11 shrink-0 place-items-center rounded-full text-ink-secondary hover:bg-surface-muted"
+              aria-label="Close"
+            >
+              <X className="h-5 w-5" aria-hidden />
+            </Dialog.Close>
+          </div>
+
+          <div className="flex-1 space-y-6 overflow-y-auto px-6 py-5">
+            <div>
+              <p className="flex items-center gap-2 text-sm font-semibold text-ink">
+                <FileText className="h-4 w-4 text-ink-secondary" aria-hidden />
+                {source.doc}
+                <span className="font-normal text-ink-tertiary">· row {source.row}</span>
+              </p>
+              {/* The excerpt is the raw source, so monospace is earned here (data, not costume). */}
+              <div className="mt-3 overflow-x-auto rounded-[10px] border border-line bg-surface-muted" tabIndex={0} role="region" aria-label={`Excerpt from ${source.doc}`}>
+                <pre className="min-w-max p-3 font-mono text-[12.5px] leading-6 text-ink-secondary">
+                  <span className="block text-ink-tertiary">{source.csvHeader}</span>
+                  {source.csvRows.map((r, i) => (
+                    <span key={i} className="relative block">
+                      {i === rowIndex && (
+                        <span aria-hidden className="trace-mark absolute -inset-x-1.5 inset-y-0 rounded-[4px] bg-accent-subtle" />
+                      )}
+                      <span className={i === rowIndex ? 'relative font-semibold text-ink' : 'relative'}>
+                        {r}
+                      </span>
+                      {i === rowIndex && <span className="sr-only"> (this value)</span>}
+                    </span>
+                  ))}
+                </pre>
+              </div>
+            </div>
+
+            <dl className="grid grid-cols-[auto_1fr] gap-x-6 gap-y-3 text-[0.9375rem]">
+              <dt className="text-ink-secondary">Result</dt>
+              <dd className="tabular font-semibold text-ink">
+                {point.value} {analyte.unit}
+              </dd>
+              <dt className="text-ink-secondary">Collected</dt>
+              <dd className="text-ink">{fmtDate(point.date)}</dd>
+              <dt className="text-ink-secondary">Reference range</dt>
+              <dd className="text-ink">{rangeText(analyte)} (per report)</dd>
+              <dt className="text-ink-secondary">Read by Asclexis</dt>
+              <dd className="text-ink">
+                Medium confidence ({Math.round(point.confidence * 100)}%). Worth a glance.
+              </dd>
+            </dl>
+
+            <div className="rounded-[12px] border border-line p-4">
+              {point.verified ? (
+                <p className="flex items-center gap-2 font-semibold text-status-verified">
+                  <CheckCheck className="h-5 w-5" aria-hidden /> Verified by you
+                </p>
+              ) : (
+                <>
+                  <p className="flex items-center gap-2 font-semibold text-ink">
+                    <PencilLine className="h-5 w-5 text-pencil" aria-hidden /> In pencil: not yet checked
+                  </p>
+                  <p className="mt-1 text-sm text-ink-secondary">
+                    Compare the highlighted row with your paper or PDF report. If they match, mark it verified.
+                  </p>
+                  <div className="mt-3 flex flex-wrap gap-2">
+                    <button
+                      type="button"
+                      onClick={onVerify}
+                      className="pressable inline-flex min-h-[44px] items-center gap-2 rounded-[10px] bg-accent px-4 text-[0.9375rem] font-semibold text-on-accent hover:bg-accent-hover"
+                    >
+                      <CheckCheck className="h-4 w-4" aria-hidden /> It matches, mark verified
+                    </button>
+                    <a
+                      href="/verify"
+                      className="pressable inline-flex min-h-[44px] items-center rounded-[10px] border border-line px-4 text-[0.9375rem] font-semibold text-ink hover:bg-surface-muted"
+                    >
+                      Correct it in Review
+                    </a>
+                  </div>
+                </>
+              )}
+            </div>
+          </div>
+
+          <p className="border-t border-line px-6 py-3 text-sm text-ink-secondary">
+            Educational information from your own records, not medical advice.
+          </p>
+        </Dialog.Content>
+      </Dialog.Portal>
+    </Dialog.Root>
+  );
+}
diff --git a/src/frontend/src/components/results/RangeRibbon.tsx b/src/frontend/src/components/results/RangeRibbon.tsx
new file mode 100644
index 0000000..78ce16b
--- /dev/null
+++ b/src/frontend/src/components/results/RangeRibbon.tsx
@@ -0,0 +1,249 @@
+import { useEffect, useLayoutEffect, useMemo, useRef, useState, type KeyboardEvent, type PointerEvent } from 'react';
+import { fmtDate, rangeStatus, statusText, type Analyte } from './fixtures';
+
+/**
+ * RANGE RIBBON (signature moment 2).
+ * - Reference range is a band, not a dashed line; label says "(per report)".
+ * - Straight segments between real points on a true time axis (no monotone
+ *   smoothing inventing values between draws).
+ * - Verified points are ink (filled); unverified points are pencil (dashed ring).
+ * - The line is revealed once per analyte per session with clip-path (640ms,
+ *   ease-out). Values never tween. Switching analytes later is a 150ms fade.
+ * - It is a slider: arrows/Home/End move the selection with NO animation
+ *   (keyboard); pointer moves glide the cursor (180ms transform).
+ */
+const seen = new Set<string>();
+
+interface Props {
+  analyte: Analyte;
+  selected: number;
+  onSelect: (i: number) => void;
+  height?: number;
+}
+
+function niceTicks(min: number, max: number, count = 4) {
+  const span = max - min || 1;
+  const raw = span / count;
+  const mag = 10 ** Math.floor(Math.log10(raw));
+  const step = [1, 2, 2.5, 5, 10].map((m) => m * mag).find((s) => s >= raw) ?? raw;
+  const start = Math.floor(min / step) * step;
+  const ticks: number[] = [];
+  for (let v = start; v <= max + step * 0.001; v += step) ticks.push(+v.toFixed(6));
+  return ticks;
+}
+
+export function RangeRibbon({ analyte, selected, onSelect, height = 280 }: Props) {
+  const wrapRef = useRef<HTMLDivElement>(null);
+  const [width, setWidth] = useState(640);
+  const [input, setInput] = useState<'pointer' | 'key'>('key');
+  // Captured once at mount (the parent keys this component by analyte id).
+  const [firstView] = useState(() => !seen.has(analyte.id));
+  const [revealed, setRevealed] = useState(!firstView);
+
+  useLayoutEffect(() => {
+    const el = wrapRef.current;
+    if (!el) return;
+    setWidth(Math.max(280, Math.round(el.getBoundingClientRect().width)));
+    const ro = new ResizeObserver(([e]) => setWidth(Math.max(280, Math.round(e.contentRect.width))));
+    ro.observe(el);
+    return () => ro.disconnect();
+  }, []);
+
+  useEffect(() => {
+    if (!firstView) return;
+    seen.add(analyte.id);
+    const id = requestAnimationFrame(() => requestAnimationFrame(() => setRevealed(true)));
+    return () => cancelAnimationFrame(id);
+  }, [analyte.id, firstView]);
+
+  const pad = { l: 44, r: 20, t: 30, b: 34 };
+  const { points, refLow, refHigh } = analyte;
+
+  const geo = useMemo(() => {
+    const vals = points.map((p) => p.value);
+    const lo = Math.min(...vals, refLow ?? Infinity);
+    const hi = Math.max(...vals, refHigh ?? -Infinity);
+    const span = hi - lo || 1;
+    const ticks = niceTicks(lo - span * 0.12, hi + span * 0.12);
+    const y0 = ticks[0];
+    const y1 = ticks[ticks.length - 1];
+    const t = points.map((p) => new Date(p.date + 'T00:00:00').getTime());
+    const t0 = t[0];
+    const t1 = t[t.length - 1] === t0 ? t0 + 1 : t[t.length - 1];
+    const innerW = width - pad.l - pad.r;
+    const innerH = height - pad.t - pad.b;
+    const x = (ms: number) => pad.l + ((ms - t0) / (t1 - t0)) * innerW;
+    const y = (v: number) => pad.t + (1 - (v - y0) / (y1 - y0)) * innerH;
+    const xy = points.map((p, i) => ({ x: x(t[i]), y: y(p.value) }));
+    const band =
+      refLow != null || refHigh != null
+        ? {
+            top: y(Math.min(refHigh ?? y1, y1)),
+            bottom: y(Math.max(refLow ?? y0, y0)),
+          }
+        : null;
+    return { ticks, y, xy, band, innerW };
+  }, [points, refLow, refHigh, width, height, pad.l, pad.r, pad.t, pad.b]);
+
+  const nearest = (clientX: number) => {
+    const rect = wrapRef.current!.getBoundingClientRect();
+    const px = clientX - rect.left;
+    let best = 0;
+    geo.xy.forEach((p, i) => {
+      if (Math.abs(p.x - px) < Math.abs(geo.xy[best].x - px)) best = i;
+    });
+    return best;
+  };
+
+  const onPointer = (e: PointerEvent) => {
+    if (e.pointerType === 'mouse' && e.buttons === 0 && e.type === 'pointerdown') return;
+    setInput('pointer');
+    const i = nearest(e.clientX);
+    if (i !== selected) onSelect(i);
+  };
+
+  const onKey = (e: KeyboardEvent) => {
+    const last = points.length - 1;
+    const next =
+      e.key === 'ArrowLeft' || e.key === 'ArrowDown' ? Math.max(0, selected - 1)
+      : e.key === 'ArrowRight' || e.key === 'ArrowUp' ? Math.min(last, selected + 1)
+      : e.key === 'Home' ? 0
+      : e.key === 'End' ? last
+      : null;
+    if (next == null) return;
+    e.preventDefault();
+    setInput('key');
+    onSelect(next);
+  };
+
+  const sel = points[selected];
+  const status = rangeStatus(sel.value, refLow, refHigh);
+  const valueText = `${fmtDate(sel.date)}: ${sel.value} ${analyte.unit}. ${statusText[status]}. ${
+    sel.verified ? 'Verified by you.' : 'Not yet verified.'
+  }`;
+
+  const segs = geo.xy.slice(1).map((p, i) => ({
+    a: geo.xy[i],
+    b: p,
+    pencil: !points[i].verified || !points[i + 1].verified,
+  }));
+  const cursorX = geo.xy[selected].x;
+
+  return (
+    <div
+      ref={wrapRef}
+      role="slider"
+      tabIndex={0}
+      aria-label={`${analyte.name} results over time`}
+      aria-valuemin={0}
+      aria-valuemax={points.length - 1}
+      aria-valuenow={selected}
+      aria-valuetext={valueText}
+      onKeyDown={onKey}
+      onPointerMove={(e) => e.pointerType === 'mouse' && onPointer(e)}
+      onPointerDown={onPointer}
+      className="relative touch-pan-y select-none rounded-[10px] outline-offset-4"
+      style={{ height }}
+    >
+      <svg width={width} height={height} className="block overflow-visible" aria-hidden>
+        {/* ruled lines: the chart is a measuring tool, so it earns a grid */}
+        {geo.ticks.map((t) => (
+          <g key={t}>
+            <line x1={44} x2={width - 20} y1={geo.y(t)} y2={geo.y(t)} stroke="var(--line)" strokeWidth={1} />
+            <text x={36} y={geo.y(t)} dy="0.32em" textAnchor="end" className="tabular fill-[var(--ink-3)] text-[12px]">
+              {t}
+            </text>
+          </g>
+        ))}
+
+        {geo.band && (
+          <g>
+            <rect
+              x={44}
+              y={geo.band.top}
+              width={geo.innerW}
+              height={Math.max(0, geo.band.bottom - geo.band.top)}
+              fill="var(--band)"
+              rx={4}
+            />
+          </g>
+        )}
+
+        {/* x labels */}
+        {geo.xy.map((p, i) => (
+          <text
+            key={i}
+            x={p.x}
+            y={height - 10}
+            textAnchor={i === 0 ? 'start' : i === points.length - 1 ? 'end' : 'middle'}
+            className="tabular fill-[var(--ink-3)] text-[12px]"
+          >
+            {fmtDate(points[i].date, { month: 'short', year: '2-digit' })}
+          </text>
+        ))}
+
+        {/* selection cursor: glides for pointer input, jumps for keyboard */}
+        <g
+          style={{
+            transform: `translateX(${cursorX}px)`,
+            transition: input === 'pointer' ? 'transform 180ms var(--ease-out)' : 'none',
+          }}
+        >
+          <line x1={0} x2={0} y1={8} y2={height - 28} stroke="var(--line-strong)" strokeWidth={1} strokeDasharray="1 3" />
+        </g>
+
+        {/* data: revealed once with clip-path; this is the authored moment */}
+        <g
+          key={analyte.id}
+          style={{
+            clipPath: revealed ? 'inset(-12px -12px -12px -12px)' : `inset(-12px ${width}px -12px -12px)`,
+            transition: revealed && firstView ? 'clip-path var(--dur-reveal) var(--ease-out)' : 'none',
+            animation: firstView ? undefined : 'scrimIn 150ms ease both',
+          }}
+          className="ribbon-data"
+        >
+          {segs.map((s, i) => (
+            <line
+              key={i}
+              x1={s.a.x}
+              y1={s.a.y}
+              x2={s.b.x}
+              y2={s.b.y}
+              stroke={s.pencil ? 'var(--pencil)' : 'var(--accent)'}
+              strokeWidth={s.pencil ? 1.75 : 2.25}
+              strokeDasharray={s.pencil ? '4 4' : undefined}
+              strokeLinecap="round"
+            />
+          ))}
+          {geo.xy.map((p, i) => {
+            const pt = points[i];
+            const isSel = i === selected;
+            return (
+              <g key={i} transform={`translate(${p.x} ${p.y})`}>
+                <circle r={11} fill="none" stroke="var(--accent)" strokeWidth={1.5} style={{ opacity: isSel ? 1 : 0, transition: 'opacity 150ms ease' }} />
+                <circle
+                  r={5.5}
+                  className="ink-dot"
+                  data-verified={pt.verified}
+                  style={{
+                    fill: pt.verified ? 'var(--accent)' : 'var(--surface-1)',
+                    stroke: pt.verified ? 'var(--surface-1)' : 'var(--pencil)',
+                    strokeWidth: pt.verified ? 2 : 1.75,
+                    strokeDasharray: pt.verified ? '40 0' : '2.6 2.6',
+                  }}
+                />
+                {rangeStatus(pt.value, refLow, refHigh) !== 'within' && (
+                  // outside-range marker: a shape, not only a colour (WCAG 1.4.1)
+                  <path
+                    d={rangeStatus(pt.value, refLow, refHigh) === 'below' ? 'M-4 13 L4 13 L0 19 Z' : 'M-4 -13 L4 -13 L0 -19 Z'}
+                    fill="var(--outside)"
+                  />
+                )}
+              </g>
+            );
+          })}
+        </g>
+      </svg>
+    </div>
+  );
+}
diff --git a/src/frontend/src/components/results/fixtures.ts b/src/frontend/src/components/results/fixtures.ts
new file mode 100644
index 0000000..1830ba9
--- /dev/null
+++ b/src/frontend/src/components/results/fixtures.ts
@@ -0,0 +1,153 @@
+/**
+ * Prototype fixtures shaped like services/types.ts TrendData/TrendPoint, using the
+ * same values the UI review seeded through the real API (glucose 92/104/118/101,
+ * ref 70-99 mg/dL; LDL 142; HbA1c 6.1 …). Source rows mirror the seeded CSVs.
+ */
+export interface ResultPoint {
+  date: string; // ISO date
+  value: number;
+  verified: boolean;
+  confidence: number; // 0..1, extraction confidence
+  source: { doc: string; row: number; csvHeader: string; csvRows: string[] };
+}
+export interface Analyte {
+  id: string;
+  name: string;
+  panel: 'Metabolic' | 'Lipids' | 'Blood count' | 'Thyroid';
+  unit: string;
+  refLow: number | null;
+  refHigh: number | null;
+  points: ResultPoint[];
+}
+
+const header = 'test_name,value,unit,reference_range,collected_date';
+function series(
+  doc: string,
+  test: string,
+  unit: string,
+  range: string,
+  rows: [string, number, boolean][]
+): ResultPoint[] {
+  const csvRows = rows.map(([d, v]) => `${test},${v},${unit},${range},${d}`);
+  return rows.map(([date, value, verified], i) => ({
+    date,
+    value,
+    verified,
+    confidence: 0.6,
+    source: { doc, row: i + 2, csvHeader: header, csvRows },
+  }));
+}
+
+export const analytes: Analyte[] = [
+  {
+    id: 'glucose',
+    name: 'Glucose',
+    panel: 'Metabolic',
+    unit: 'mg/dL',
+    refLow: 70,
+    refHigh: 99,
+    points: series('glucose.csv', 'Glucose', 'mg/dL', '70-99', [
+      ['2025-10-10', 92, true],
+      ['2026-01-10', 104, true],
+      ['2026-04-10', 118, false],
+      ['2026-07-10', 101, true],
+    ]),
+  },
+  {
+    id: 'hba1c',
+    name: 'Hemoglobin A1c',
+    panel: 'Metabolic',
+    unit: '%',
+    refLow: 4,
+    refHigh: 5.6,
+    points: series('a1c.csv', 'Hemoglobin A1c', '%', '4-5.6', [
+      ['2025-10-10', 5.3, true],
+      ['2026-01-10', 5.4, true],
+      ['2026-04-10', 5.9, false],
+      ['2026-07-10', 6.1, false],
+    ]),
+  },
+  {
+    id: 'ldl',
+    name: 'LDL cholesterol',
+    panel: 'Lipids',
+    unit: 'mg/dL',
+    refLow: 0,
+    refHigh: 99,
+    points: series('lipids.csv', 'LDL Cholesterol', 'mg/dL', '0-99', [
+      ['2025-07-10', 128, true],
+      ['2026-01-10', 135, true],
+      ['2026-07-10', 142, true],
+    ]),
+  },
+  {
+    id: 'hdl',
+    name: 'HDL cholesterol',
+    panel: 'Lipids',
+    unit: 'mg/dL',
+    refLow: 40,
+    refHigh: null,
+    points: series('lipids.csv', 'HDL Cholesterol', 'mg/dL', '>=40', [
+      ['2025-07-10', 52, true],
+      ['2026-07-10', 48, true],
+    ]),
+  },
+  {
+    id: 'tg',
+    name: 'Triglycerides',
+    panel: 'Lipids',
+    unit: 'mg/dL',
+    refLow: 0,
+    refHigh: 149,
+    points: series('lipids.csv', 'Triglycerides', 'mg/dL', '0-149', [
+      ['2025-07-10', 140, true],
+      ['2026-07-10', 160, false],
+    ]),
+  },
+  {
+    id: 'hgb',
+    name: 'Hemoglobin',
+    panel: 'Blood count',
+    unit: 'g/dL',
+    refLow: 13.2,
+    refHigh: 16.6,
+    points: series('cbc.csv', 'Hemoglobin', 'g/dL', '13.2-16.6', [
+      ['2026-01-10', 14.2, true],
+      ['2026-07-10', 13.9, true],
+    ]),
+  },
+  {
+    id: 'tsh',
+    name: 'TSH',
+    panel: 'Thyroid',
+    unit: 'mIU/L',
+    refLow: 0.4,
+    refHigh: 4,
+    points: series('thyroid.csv', 'TSH', 'mIU/L', '0.4-4', [
+      ['2025-10-10', 2.4, true],
+      ['2026-07-10', 2.1, true],
+    ]),
+  },
+];
+
+export type RangeStatus = 'above' | 'below' | 'within' | 'unknown';
+export function rangeStatus(v: number, lo: number | null, hi: number | null): RangeStatus {
+  if (lo == null && hi == null) return 'unknown';
+  if (hi != null && v > hi) return 'above';
+  if (lo != null && v < lo) return 'below';
+  return 'within';
+}
+export const statusText: Record<RangeStatus, string> = {
+  above: 'Above the reference range (per report)',
+  below: 'Below the reference range (per report)',
+  within: 'Within the reference range (per report)',
+  unknown: 'No reference range on the report',
+};
+export function rangeText(a: Pick<Analyte, 'refLow' | 'refHigh' | 'unit'>) {
+  if (a.refLow != null && a.refHigh != null) return `${a.refLow}–${a.refHigh} ${a.unit}`;
+  if (a.refLow != null) return `${a.refLow} ${a.unit} or more`;
+  if (a.refHigh != null) return `up to ${a.refHigh} ${a.unit}`;
+  return 'not stated';
+}
+export const fmtDate = (iso: string, opts: Intl.DateTimeFormatOptions = { month: 'short', day: 'numeric', year: 'numeric' }) =>
+  new Date(iso + 'T00:00:00').toLocaleDateString('en-US', opts);
