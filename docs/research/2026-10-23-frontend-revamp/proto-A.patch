+import * as Popover from '@radix-ui/react-popover';
+import { ShieldCheck } from 'lucide-react';
+
+/**
+ * Replaces the placebo "Safety Mode ON/OFF" toggle (TopBar.tsx useState). Not a
+ * switch: the guards are always on, so the chrome states that instead. Opens on
+ * click/tap (never hover-only).
+ */
+export function SafetyNote({ compact = false }: { compact?: boolean }) {
+  return (
+    <Popover.Root>
+      <Popover.Trigger
+        className="pressable inline-flex min-h-[44px] items-center gap-2 rounded-full border border-line bg-surface-elevated px-3.5 text-sm font-medium text-ink-secondary hover:text-ink"
+      >
+        <ShieldCheck className="h-4 w-4 text-status-verified" aria-hidden />
+        {compact ? <span>Educational</span> : <span>Educational use · not medical advice</span>}
+      </Popover.Trigger>
+      <Popover.Portal>
+        <Popover.Content
+          align="end"
+          sideOffset={8}
+          collisionPadding={16}
+          className="popover z-50 w-[min(22rem,calc(100vw-32px))] rounded-[14px] border border-line bg-surface-elevated p-5 text-sm text-ink-secondary shadow-[var(--shadow-2)]"
+        >
+          <p className="text-base font-semibold text-ink">What Asclexis does, and doesn't</p>
+          <ul className="mt-3 space-y-2 leading-relaxed">
+            <li>It explains what your own reports say, with a link to the line each number came from.</li>
+            <li>It does not diagnose, suggest doses or replace your clinician.</li>
+            <li>The safety checks on every explanation are always on. There is no switch to turn them off.</li>
+            <li>Everything stays on this device unless you export it.</li>
+          </ul>
+          <Popover.Arrow className="fill-[var(--surface-1)]" />
+        </Popover.Content>
+      </Popover.Portal>
+    </Popover.Root>
+  );
+}
