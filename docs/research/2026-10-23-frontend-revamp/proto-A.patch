diff --git a/src/frontend/src/components/layout/CommandPalette.tsx b/src/frontend/src/components/layout/CommandPalette.tsx
new file mode 100644
index 0000000..bac6fe2
--- /dev/null
+++ b/src/frontend/src/components/layout/CommandPalette.tsx
@@ -0,0 +1,86 @@
+import { useEffect, useState } from 'react';
+import { useNavigate } from 'react-router-dom';
+import { Command } from 'cmdk';
+import * as Dialog from '@radix-ui/react-dialog';
+import { allNavItems } from './navConfig';
+import { analytes } from '@/components/results/fixtures';
+
+import { OPEN_EVENT } from './paletteEvents';
+
+/**
+ * Keyboard-first, opened 100+ times a day by power users: NO open/close animation
+ * (Emil: never animate keyboard-initiated, high-frequency actions).
+ */
+export function CommandPalette({ initialOpen = false }: { initialOpen?: boolean }) {
+  const [open, setOpen] = useState(initialOpen);
+  const navigate = useNavigate();
+
+  useEffect(() => {
+    const onKey = (e: KeyboardEvent) => {
+      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
+        e.preventDefault();
+        setOpen((o) => !o);
+      }
+    };
+    const onOpen = () => setOpen(true);
+    window.addEventListener('keydown', onKey);
+    window.addEventListener(OPEN_EVENT, onOpen);
+    return () => {
+      window.removeEventListener('keydown', onKey);
+      window.removeEventListener(OPEN_EVENT, onOpen);
+    };
+  }, []);
+
+  const go = (to: string) => {
+    setOpen(false);
+    navigate(to);
+  };
+
+  const item =
+    'flex min-h-[44px] cursor-pointer items-center gap-3 rounded-[8px] px-3 text-[0.9375rem] text-ink data-[selected=true]:bg-accent-subtle data-[selected=true]:text-accent-ink';
+
+  return (
+    <Dialog.Root open={open} onOpenChange={setOpen}>
+      <Dialog.Portal>
+      <Dialog.Overlay className="fixed inset-0 z-50 bg-[var(--scrim)]" />
+      <Dialog.Content
+        aria-describedby={undefined}
+        className="fixed left-1/2 top-[12vh] z-50 w-[min(40rem,calc(100vw-32px))] -translate-x-1/2 overflow-hidden rounded-[14px] border border-line bg-surface-elevated shadow-[var(--shadow-3)]"
+      >
+      <Dialog.Title className="sr-only">Search and commands</Dialog.Title>
+      <Command label="Search and commands">
+      <Command.Input
+        placeholder="Search results, documents, actions…"
+        className="h-14 w-full border-b border-line bg-transparent px-4 text-base text-ink outline-none placeholder:text-ink-tertiary"
+      />
+      <Command.List className="max-h-[50vh] overflow-y-auto p-2">
+        <Command.Empty className="px-3 py-6 text-sm text-ink-secondary">
+          No match. Press Enter to search all records.
+        </Command.Empty>
+        <Command.Group heading="Results" className="text-xs font-semibold text-ink-tertiary [&_[cmdk-group-heading]]:px-3 [&_[cmdk-group-heading]]:py-2">
+          {analytes.map((a) => (
+            <Command.Item key={a.id} value={`result ${a.name}`} onSelect={() => go(`/results?analyte=${a.id}`)} className={item}>
+              {a.name}
+              <span className="ml-auto tabular text-sm text-ink-secondary">
+                {a.points[a.points.length - 1].value} {a.unit}
+              </span>
+            </Command.Item>
+          ))}
+        </Command.Group>
+        <Command.Group heading="Go to" className="text-xs font-semibold text-ink-tertiary [&_[cmdk-group-heading]]:px-3 [&_[cmdk-group-heading]]:py-2">
+          {allNavItems.map((n) => (
+            <Command.Item key={n.to} value={`go ${n.label}`} onSelect={() => go(n.to)} className={item}>
+              <n.icon className="h-4 w-4 text-ink-secondary" aria-hidden /> {n.label}
+            </Command.Item>
+          ))}
+          <Command.Item value="go settings" onSelect={() => go('/settings')} className={item}>
+            Settings
+          </Command.Item>
+        </Command.Group>
+      </Command.List>
+      </Command>
+      </Dialog.Content>
+      </Dialog.Portal>
+    </Dialog.Root>
+  );
+}
diff --git a/src/frontend/src/components/layout/MobileNav.tsx b/src/frontend/src/components/layout/MobileNav.tsx
new file mode 100644
index 0000000..a70a57d
--- /dev/null
+++ b/src/frontend/src/components/layout/MobileNav.tsx
@@ -0,0 +1,90 @@
+import { useState } from 'react';
+import { NavLink, useLocation } from 'react-router-dom';
+import * as Dialog from '@radix-ui/react-dialog';
+import { MoreHorizontal, X, Settings } from 'lucide-react';
+import { cn } from '@/utils/cn';
+import { allNavItems, isItemActive, mobileTabs, navGroups } from './navConfig';
+
+/** < 1024px: bottom tab bar (4 + More). The sidebar does not shrink; it is replaced. */
+export function MobileNav() {
+  const { pathname } = useLocation();
+  const [open, setOpen] = useState(false);
+  const tabs = mobileTabs.map((to) => allNavItems.find((i) => i.to === to)!);
+  const moreActive = !tabs.some((t) => isItemActive(t, pathname));
+
+  const tabClass = (active: boolean) =>
+    cn(
+      'pressable flex min-h-[56px] flex-1 flex-col items-center justify-center gap-0.5 text-xs font-semibold',
+      active ? 'text-accent-ink' : 'text-ink-secondary'
+    );
+
+  return (
+    <nav
+      aria-label="Main"
+      className="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-surface/95 pb-[env(safe-area-inset-bottom)] backdrop-blur-md lg:hidden"
+    >
+      <ul className="mx-auto flex max-w-lg">
+        {tabs.map((t) => {
+          const active = isItemActive(t, pathname);
+          return (
+            <li key={t.to} className="flex flex-1">
+              <NavLink to={t.to} aria-current={active ? 'page' : undefined} className={tabClass(active)}>
+                <span className={cn('grid h-7 w-12 place-items-center rounded-full transition-colors duration-150', active && 'bg-accent-subtle')}>
+                  <t.icon className="h-5 w-5" aria-hidden strokeWidth={active ? 2.25 : 1.75} />
+                </span>
+                {t.label}
+              </NavLink>
+            </li>
+          );
+        })}
+        <li className="flex flex-1">
+          <Dialog.Root open={open} onOpenChange={setOpen}>
+            <Dialog.Trigger className={tabClass(moreActive)}>
+              <span className={cn('grid h-7 w-12 place-items-center rounded-full', moreActive && 'bg-accent-subtle')}>
+                <MoreHorizontal className="h-5 w-5" aria-hidden />
+              </span>
+              More
+            </Dialog.Trigger>
+            <Dialog.Portal>
+              <Dialog.Overlay className="scrim fixed inset-0 z-50 bg-[var(--scrim)]" />
+              <Dialog.Content className="sheet-bottom fixed inset-x-0 bottom-0 z-50 max-h-[85dvh] overflow-y-auto rounded-t-[20px] border-t border-line bg-surface-elevated px-4 pb-[calc(16px+env(safe-area-inset-bottom))] pt-2 shadow-[var(--shadow-3)]">
+                <div className="mx-auto mb-2 h-1 w-10 rounded-full bg-surface-sunken" aria-hidden />
+                <div className="flex items-center justify-between">
+                  <Dialog.Title className="text-lg font-semibold text-ink">All sections</Dialog.Title>
+                  <Dialog.Close className="pressable grid h-11 w-11 place-items-center rounded-full text-ink-secondary hover:bg-surface-muted" aria-label="Close">
+                    <X className="h-5 w-5" aria-hidden />
+                  </Dialog.Close>
+                </div>
+                {navGroups.map((g, i) => (
+                  <section key={i} className="mt-3">
+                    {g.label && <h3 className="px-1 pb-1 text-xs font-semibold uppercase tracking-[0.06em] text-ink-tertiary">{g.label}</h3>}
+                    <ul className="grid grid-cols-2 gap-2">
+                      {g.items.map((it) => (
+                        <li key={it.to}>
+                          <NavLink
+                            to={it.to}
+                            onClick={() => setOpen(false)}
+                            className="pressable flex min-h-[52px] items-center gap-3 rounded-[12px] bg-surface-muted px-3 text-[0.9375rem] font-medium text-ink"
+                          >
+                            <it.icon className="h-5 w-5 text-accent" aria-hidden /> {it.label}
+                          </NavLink>
+                        </li>
+                      ))}
+                    </ul>
+                  </section>
+                ))}
+                <NavLink
+                  to="/settings"
+                  onClick={() => setOpen(false)}
+                  className="pressable mt-4 flex min-h-[52px] items-center gap-3 rounded-[12px] border border-line px-3 text-[0.9375rem] font-medium text-ink"
+                >
+                  <Settings className="h-5 w-5 text-ink-secondary" aria-hidden /> Settings
+                </NavLink>
+              </Dialog.Content>
+            </Dialog.Portal>
+          </Dialog.Root>
+        </li>
+      </ul>
+    </nav>
+  );
+}
