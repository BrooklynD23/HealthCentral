# HealthCentral .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
ENV/
env/
.venv/

# Developer-local helpers (ignore these so routine dirty-worktree checks stay focused)
# The repo_hygiene_check guard intentionally handles root scratch markdown/report files
# instead of hiding them behind broad ignore rules.
.bg-shell/
.wsl-pytest-venv/
.venv-test/
# Intentionally do not add broad ignore rules for local-only scratch notes/reports;
# contributors should delete or relocate those before pre-merge work.

# IDE
.vscode/
.idea/
.claude/*
!.claude/skills/
*.swp
*.swo
*~

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Node.js / Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build outputs
dist/
build/
*.bundle.js
*.bundle.js.map

# Tauri
src-tauri/target/

# Local data (SENSITIVE - never commit)
data/
profiles/
*.db
*.db-journal
*.db-shm
*.db-wal

# Local AI models (large files)
# Use /models/ to not match src/backend/models/ (SQLAlchemy models)
/models/
*.gguf
*.bin
*.safetensors

# Environment and secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Logs
logs/
*.log

# Temporary files
tmp/
temp/
cache/
.cache/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Exports (user may want these elsewhere)
exports/

# Crash reports and debugging
crash_reports/
*.dmp

# ── GSD baseline (auto-generated) ──
.gsd
*.code-workspace
.env.*
!.env.example
.next/
*.pyc
target/
vendor/
coverage/

# Playwright run artifacts (reports, traces, screenshots) — regenerated per run
src/frontend/test-results/
src/frontend/playwright-report/
